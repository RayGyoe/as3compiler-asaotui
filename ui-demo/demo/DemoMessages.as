// demo/DemoMessages.as -- the docs app's translations, in ONE table.
//
// TWO TABLES, TWO JOBS (and why they are different mechanisms):
//
//   * `zh()` is the PROSE catalog: english -> chinese, keyed by the sentence the
//     source shows. It feeds `DemoText.t()` and covers the ~680 headings,
//     paragraphs, blurbs and shell labels. Nothing in it is parameterized, so a
//     dictionary read is the whole cost. `tools/demo-i18n.cjs` proves it covers
//     every display string in `demo/*.as` -- including that no row is stale.
//
//   * `install()` registers the demo's few CHROME messages with `I18n` itself
//     (`demo.meta`, `demo.foot`, `demo.items`, ...). These carry `{placeholders}`
//     and plurals, which is exactly what `I18n.t`/`tn`/`number` already do for
//     the kit's own 55 strings; a second formatter here would be a second thing
//     to get wrong. It also gives the `i18n` page real keys to demonstrate.
//
// THE KIT'S OWN MESSAGES ARE THE FLOOR. `I18n` lazily installs KitMessages (en +
// zh-CN), so every widget's default accessible name is already translated before
// this file runs. An app that registers a key this file also uses wins for that
// key, per locale -- that is `I18n.addMessages`'s documented merge.
package demo
{
    import asaot.ui.I18n;

    public final class DemoMessages
    {
        private static var _installed:Boolean;

        // Called once, from DemoText.ensure().
        public static function install():void
        {
            if (_installed) return;
            _installed = true;
            I18n.addMessages("en", {
                // The page header's third line. `#one`/`#other` is a PLURAL, so
                // the singular never renders "1 examples" (the docs shipped that
                // bug for a year: the string was glued together in code).
                "demo.meta#one":   "kind \"{kind}\"  -  {group}  -  {n} example",
                "demo.meta#other": "kind \"{kind}\"  -  {group}  -  {n} examples",
                "demo.foot":       "{n} components  -  one page each",
                // The `i18n` page's live examples. Short on purpose: the page is
                // about the API, and a sentence per row would be a second essay.
                "demo.greet":      "Welcome back",
                "demo.saved":      "Saved {n} files to the cloud",
                "demo.items#one":  "{n} item in the cart",
                "demo.items#other": "{n} items in the cart",
                "demo.money":      "Total {amount}",
                "demo.rtl":        "The layout is mirrored; this sentence is not."
            });
            I18n.addMessages("zh-CN", {
                // Chinese has ONE plural form (CLDR "other"), so `tn` lands on
                // `#other` directly -- `#one` is deliberately absent.
                "demo.meta#other": "类型 \"{kind}\"  -  {group}  -  {n} 个示例",
                "demo.foot":       "{n} 个组件  -  每页一个",
                "demo.greet":      "欢迎回来",
                "demo.saved":      "已把 {n} 个文件保存到云端",
                "demo.items#other": "购物车里有 {n} 件商品",
                "demo.money":      "合计 {amount}",
                "demo.rtl":        "布局已镜像，这句话没有。"
            });
        }

        // The prose catalog for a locale tag (already lowercased by DemoText).
        // `null` = this locale has no prose table and reads English, which is what
        // the docs app does for `ar`: it is here to show MIRRORING, and a machine
        // translation of 680 paragraphs would be worse than the English.
        public static function table(tag:String):Object
        {
            if (tag == "zh" || tag == "zh-cn" || tag == "zh-hans") return zh();
            return null;
        }

        // ---- the prose catalog: english source text -> chinese ----------------
        // ONE PAIR PER LINE, and `tools/demo-i18n.cjs` reads it as such (the
        // `"key": "value"` shape between this function's braces is its interface).
        // Keys are the exact strings `demo/*.as` shows; values must not contain an
        // unescaped `"`, a newline or a tab.
        public static function zh():Object
        {
            return {
            "asaot.ui documentation": "asaot.ui 组件文档",
            "pure-AS3 UI toolkit": "纯 AS3 UI 库",
            "Product": "产品",
            "Tagline": "副标题",
            "Index": "索引",
            "Component page": "组件页",
            "Component": "组件",
            "Summary": "摘要",
            "Details": "明细",
            "Example": "示例",
            "Source": "源码",
            "Language": "语言",
            "Apps": "应用",
            "Getting started": "入门",
            "Layout": "布局",
            "Text & badges": "文本与徽标",
            "Controls": "控件",
            "Pickers": "选择器",
            "Data": "数据",
            "Navigation": "导航",
            "Feedback": "反馈",
            "Overlay": "浮层",
            "Motion": "动效",
            "System": "系统",

            // ---- DocsCatalog.as
            "22 ticking quotes, 22 sparklines and the frame's own numbers.": "22 条不断跳动的报价、22 条迷你折线，以及这一帧自身的数字。",
            "A boolean with a label. Bound or plain.": "带标签的布尔值。可绑定，也可不绑定。",
            "A bordered, optionally titled surface for grouped content.": "带边框、可选标题的表面，用于归组内容。",
            "A calendar panel behind a trigger.": "藏在触发元素之后的日历面板。",
            "A circular initial from a name.": "由名字生成首字母的圆形头像。",
            "A clipped viewport over content taller than itself.": "内容高于自身时的裁剪视口。",
            "A count pill, usually pinned to a corner.": "计数小药丸，通常钉在某个角上。",
            "A determinate bar with a label.": "带标签的确定性进度条。",
            "A flattened, expandable hierarchy.": "扁平化、可展开的层级结构。",
            "A hairline rule, horizontal or vertical.": "一条细发丝线，横向或纵向。",
            "A list of actions anchored to a trigger.": "锚定在触发元素上的一组操作列表。",
            "A list of options behind a trigger.": "藏在触发元素之后的选项列表。",
            "A multi-line field: Enter inserts a newline, the box is `rows` lines tall.": "多行输入框：按回车插入换行，框高为 `rows` 行。",
            "A number in a box: steppers, a clamp range and a step.": "框里的数字：步进按钮、上下限与步长。",
            "A panel anchored to a key, sized by its content.": "锚定到某个 key 上的面板，大小由内容决定。",
            "A picture -- a BitmapData or a `src` -- scaled into its box.": "一张图片 —— BitmapData 或 `src` —— 缩放后放进框内。",
            "A pressable label. Variants are styles, not kinds.": "可点击的标签。变体是样式，不是种类。",
            "A run of text: the only node that owns a string.": "一段文本：唯一自己持有字符串的节点。",
            "A scrim plus a centred panel -- overlay tree only.": "一层遮罩加一个居中面板 —— 只存在于 overlay 树。",
            "A select whose menu stays open and reports each toggle.": "菜单保持展开、并逐项上报切换状态的下拉框。",
            "A select whose options are filtered by typing.": "选项会随输入被过滤的下拉框。",
            "A series in a box: the shape of a day, a hundred points wide.": "框里的一段系列数据：一天的形状，一百个点宽。",
            "A small bubble with an arrow.": "一个带箭头的小气泡。",
            "A small tonal tag: neutral, info or danger.": "小的色调标签：中性、信息或危险。",
            "A strip that writes its index back through a Binding.": "通过 Binding 把自身索引回写的条带。",
            "A switch: the `switch` kind, spelled around the keyword.": "开关：`switch` 类型，名字绕开了该关键字。",
            "A trail of crumbs; the last one is current.": "一串面包屑；最后一项是当前页。",
            "A transient corner message.": "短暂出现的角落消息。",
            "A value dragged along a track.": "沿轨道拖动取值的滑块。",
            "An SVG path drawn into its box: stroke or fill, any colour, any size.": "绘制进框内的 SVG 路径：描边或填充，任意颜色、任意尺寸。",
            "An edge sheet: the window's own gutter.": "边缘抽屉：窗口自身的边槽。",
            "An equal-cell bottom bar: one selected, each tap reports its own index.": "等宽单元格的底部栏：只选中一个，每次点击各自回报自己的下标。",
            "An indeterminate ring.": "不确定进度的圆环。",
            "Bindings, notify(dirty) and the Subscription: who owns a value.": "Binding、notify(dirty) 与 Subscription：谁拥有这个值。",
            "Columns and rows, aligned by the layout engine.": "列与行，由布局引擎对齐。",
            "Describe a tree in render(); UiApp reconciles it into a retained one.": "在 render() 里描述一棵树；UiApp 把它协调成常驻树。",
            "Editable text, optionally bound, masked or ghosted.": "可编辑文本，可选绑定、掩码或灰字占位。",
            "Four layers -- control default, theme slot, inherited text, author style.": "四层——控件默认、主题槽位、继承文本、作者样式。",
            "Headers that open one panel -- or several, with mode: 'multi'.": "标题栏可展开一个面板——或借助 mode: 'multi' 展开多个。",
            "Leading/title/trailing, and a large title folded away by one number.": "前导/标题/尾随三段，以及用一个数字收起的大标题。",
            "Loading placeholders in text/circle/rect shapes.": "text/circle/rect 三种形态的加载占位。",
            "Message catalogs, one locale per window, and text that mirrors with it.": "消息目录、每个窗口一个语言环境，以及随之镜像的文本。",
            "One of N in a named group.": "具名分组内的 N 选一。",
            "Only the visible rows exist as nodes.": "只有可见的行才存在为节点。",
            "Page numbers with ellipses, as chips.": "带省略号的页码，做成 chip 样式。",
            "Pages that overlap and stay mounted: only the top one is visible.": "页面相互叠放并保持挂载：只有最上面那页可见。",
            "Right click with its stage point, double click behind a runtime flag.": "带舞台坐标的右键，以及运行时开关控制的双击。",
            "Style transitions and the tween core: one mechanism, every widget.": "样式过渡与补间内核：一套机制，服务每个控件。",
            "The 35 fields: size, flex, spacing, box model, paint, transitions.": "35 个字段：尺寸、弹性、间距、盒模型、绘制、过渡。",
            "The bottom-right stack toasts drop into.": "右下角的堆叠区，toast 就落入这里。",
            "The focus ring, Tab, Enter/Space, the per-kind key map, and the keymap.": "焦点环、Tab、Enter/Space、按种类划分的键映射，以及 keymap。",
            "The plain container: direction, padding, gap, background, border.": "最朴素的容器：方向、内边距、间隙、背景、边框。",
            "The platform's answers -- hasHover, safeArea, pixelRatio -- and who reads them.": "平台给出的答案——hasHover、safeArea、pixelRatio——以及谁在读它们。",
            "The root of the SECOND retained tree (View.renderOverlay).": "第二棵常驻树的根（View.renderOverlay）。",
            "Two panes and a grip: one ratio, a minSize floor, and a drag that reports it.": "两个面板加一个把手：一个比例、minSize 下限，以及上报它的拖动。",
            "Two thumbs on one track: a low and a high value.": "一条轨道上的两个滑块：一低一高两个值。",
            "box with direction \"column\" -- the default flow.": "direction 设为 column 的 box——默认流向。",
            "box with direction \"row\".": "direction 设为 row 的 box。",
            "hitSlop, pointerEvents and the pointer a drag is built on.": "hitSlop、pointerEvents，以及拖动所依赖的指针。",
            "items -> rows, mapped once per render.": "items -> rows，每次渲染映射一次。",
            "text() with a form-row name. An alias, not a kind.": "带 form-row 名称的 text()。只是别名，并非一种节点。",

            // ---- DocsControls.as
            "0 and 1 are positions, not absences: a slider at its left end still draws a knob and still reports 0. The two below are pinned to the ends so the track, the fill and the knob can be read without dragging anything.": "0 和 1 是位置，不是缺席：滑块停在其最左端时仍然会画出旋钮，也仍然上报 0。下面两个被钉在两端，所以不用拖动任何东西就能看清轨道、填充和旋钮。",
            "A button's label is just a string the render computes -- it is re-pointed every frame, so a counter needs no special API.": "按钮的标签只是渲染时算出来的一个字符串——它每帧都会被重新指向，所以做一个计数器不需要任何专门的 API。",
            "A checkbox is one node: the 16pt box AND the text beside it. Click the word, not just the square. The label also wraps nowhere -- a checkbox is a single-line control, so a long label needs a column and a separate text() if it must break.": "复选框是一个节点：16pt 的方框与它旁边的文字合为一体。请点文字，而不只是点那个方块。标签同样不会换行——复选框是单行控件，所以长标签若必须折行，就得放进 column 并另用一个 text()。",
            "A dialog footer is two buttons and one alignment": "对话框页脚就是两个按钮加一条对齐",
            "A disabled checkbox keeps its checked state and drops the handler -- the state is displayed, not destroyed.": "被禁用的复选框保留它的勾选状态，只丢掉处理函数——状态被展示出来，而不是被销毁。",
            "A disabled slider is drawn at the disabled alpha and its track refuses the press; the value it was given is what you see. This is how a slider shows a setting that is controlled elsewhere.": "被禁用的滑块按禁用透明度绘制，它的轨道拒绝按下；你看到的就是它被赋予的那个值。滑块正是用这种方式来展示一个由别处控制的设置。",
            "A field measures nothing but its own text: give it a height and the run is vertically centred in it, give it a width and the caret walks inside it. Three sizes of the same placeholder, which is how a dense toolbar and a form differ.": "输入框只量它自己的文本：给它一个高度，这段文字就在其中垂直居中；给它一个宽度，光标就在其内部移动。同一个占位文本的三种尺寸，这正是密集工具栏与表单的差别所在。",
            "A group is a string, so it can span containers": "group 是一个字符串，因此它可以跨容器",
            "A labelled form row": "一行带标签的表单",
            "A locked field still shows its value and still keeps the text -- what it loses is the press, the caret and the focus. The second field below is the same call inside a disabled column, which is how a read-only form section is usually built.": "被锁定的输入框仍然显示它的值，也仍然保留文本——它失去的是按下、光标和焦点。下面第二个输入框是放在禁用 column 内的同一个调用，只读的表单区块通常就是这么构造的。",
            "A locked option still shows WHICH one is chosen; it only refuses the click. That is the difference between a disabled radio and an omitted one.": "被锁定的选项仍然显示选中的是哪一个；它只是拒绝点击。这就是被禁用的单选按钮与被省略的单选按钮之间的区别。",
            "A locked switch still shows whether it is on. The knob does not slide and the row does not click -- but the state the user needs to read is still there.": "被锁定的开关仍然显示它是否处于打开状态。旋钮不会滑动，整行也不响应点击——但用户需要读取的那个状态依然在那里。",
            "A number, with steppers": "一个数字，带步进器",
            "A radio names its GROUP: two radios with the same `group` are mutually exclusive without any shared parent widget, so a group can span columns.": "单选按钮自己声明它的 GROUP：两个 `group` 相同的单选按钮无需共享任何父控件就互斥，因此一个组可以跨列。",
            "A radio with no group excludes nothing": "没有 group 的单选按钮不排斥任何东西",
            "A range is TWO numbers, so there is no Binding: the contract is onRange(lo, hi) and each one is a 0..1 position on the track. A thumb cannot be dragged past its partner -- the pair is clamped against itself, so lo never exceeds hi -- and the widget reports both values on every move, not a delta.": "范围是两个数字，所以没有 Binding：契约是 onRange(lo, hi)，其中每个值都是轨道上 0..1 的一个位置。一个滑块柄不能被拖过它的伙伴——这一对值彼此夹紧，因此 lo 永远不会超过 hi——并且控件在每次移动时上报两个值，而不是一个增量。",
            "A settings block": "一个设置区块",
            "A switch": "一个开关",
            "A switch and a checkbox take the same `checked` and report the same boolean -- so one model field can drive both. The kit keeps two kinds because the two are read differently (\"takes effect now\" vs \"part of what I am submitting\"), not because the data differs.": "开关和复选框接受同样的 `checked`、上报同样的布尔值——所以一个模型字段就能同时驱动两者。这套组件之所以保留两种类型，是因为两者的读法不同（「立即生效」与「我正在提交的内容的一部分」），而不是因为数据有差别。",
            "A text area is its own KIND, not a flag on the single-line field: the difference is Enter -- a single-line field COMMITS on it, here it inserts. So this widget never consumes 13; the runtime inserts the line break itself, and only for a key nobody took.": "文本域是一个独立的类型，而不是单行输入框上的一个开关：差别就在 Enter 键——单行输入框在按下它时提交，这里则是插入换行。所以这个控件从不消费 13；换行由运行时自己插入，而且只针对没人接管的按键。",
            "A value along a track": "沿轨道取值",
            "Checked state": "勾选状态",
            "Commit, not every keystroke": "提交，而不是每次按键",
            "Disabled": "禁用",
            "Disabled is the container's word": "禁用是容器的措辞",
            "Disabled keeps its position": "禁用后仍保留位置",
            "Disabled keeps the choice visible": "禁用后仍让选择可见",
            "Disabled keeps the position": "禁用后仍保留位置",
            "Enter and Space press the focused control": "Enter 与空格会按下获得焦点的控件",
            "Enter inserts a newline": "Enter 插入换行",
            "Label from state": "标签来自状态",
            "Leave `group` out and the radio is just a circle that reports its own boolean -- both below can be selected at once. That is not a bug to work around: it is how the widget stays honest when the author has not said what the set is.": "省掉 `group`，单选按钮就只是一个圆圈，上报它自己的布尔值——下面两个可以同时被选中。这不是需要绕开的 bug：当作者没有说清「这一组是什么」的时候，控件正是靠这种方式保持诚实。",
            "Left right arrow keys, then compare the numbers below with the labels.": "按左右方向键，然后把下面的数字与标签对照一下。",
            "Longer than the box, so it scrolls": "比框更长，所以会滚动",
            "Masked": "遮蔽显示",
            "No group, no parent: each checkbox owns exactly one boolean in the model, and the summary line is an expression over the three. This is the shape a settings block uses -- and the shape a radio group deliberately does not.": "没有分组，也没有父节点：每个复选框在模型里恰好占一个布尔值，而汇总那一行是对这三个值的表达式。这正是设置区块采用的形式——也正是单选组刻意不采用的形式。",
            "Normalised once, in the factory": "在工厂函数里归一化一次",
            "One of N": "N 选一",
            "Only the Enter key tells them apart": "只有回车键能区分它们",
            "Placeholder and value": "占位提示与值",
            "Same boolean contract as the checkbox, with a sliding knob instead of a tick.": "与复选框相同的布尔契约，只是把勾号换成了滑动旋钮。",
            "Same box, same border, same text: the two below are a textArea(rows:1) and a textField. Press Enter in each -- the left one grows a line, the right one commits and stays one line. That difference is the entire reason they are two kinds instead of one with a flag.": "同样的框、同样的边框、同样的文字：下面两个分别是 textArea(rows:1) 和 textField。在各自里面按回车——左边会长出一行，右边会提交并保持一行。正是这个差异，让它们成为两种 kind，而不是一个带标志位的控件。",
            "Tab to a button and press Enter or Space: UiApp runs the default activation path, which calls the click handler unless the control names an `action` (then the app's action registry gets it). One exception is deliberate -- when the focused thing is an editable field, Enter is its commit and Space is a character.": "用 Tab 走到一个按钮上，按回车或空格：UiApp 会走默认的激活路径，调用点击处理器——除非该控件声明了 `action`（那就由应用的 action 注册表接手）。有一个例外是刻意保留的：当焦点落在一个可编辑字段上时，回车是它的提交，空格是一个字符。",
            "The arrow keys move the thumb nearest the focus, step at a time.": "方向键会让离焦点最近的那个滑块移动，每次一个 step。",
            "The band can be everything or a point": "这段区间可以是整条，也可以是一个点",
            "The bounds are the widget's, not the handler's": "边界由控件负责，不由处理器负责",
            "The box is yours; the text is centred in it": "框由你决定；文字在其中居中",
            "The checkbox reports the NEW boolean through onChange; the model owns it. A checkbox that kept its own state would be the one thing the reconciler cannot re-describe.": "复选框通过 onChange 上报那个新的布尔值；所有权在模型。一个自己保存状态的复选框，恰恰是协调器唯一无法重新描述的东西。",
            "The ends are values too": "两端也是值",
            "The ghost text is its own non-interactive TextField, shown only while the field is empty and NOT focused (a focused empty field shows the caret instead).": "幽灵文字是一个独立的、不接收交互的 TextField，只在字段为空且未获得焦点时显示（空字段获得焦点时，显示的是光标而不是它）。",
            "The kind is `switch`; the factory is toggle(), because `switch` is a reserved word.": "kind 是 `switch`；工厂函数是 toggle()，因为 `switch` 是保留字。",
            "The label is part of the hit target": "标签也是命中区域的一部分",
            "The right 32pt of the box is the STEPPER strip (upper half adds, lower half subtracts); everything to its left is a real textField, so typing, selection and the caret behave exactly like the single-line field on the previous page. step is what the steppers AND the arrow keys move by, and every write is CLAMPED into [min, max] before any callback sees it.": "框右侧的 32pt 是步进条（上半部分加、下半部分减）；它左边的部分是一个真正的 textField，所以输入、选中和光标的表现与上一页的单行字段完全一样。步进按钮和方向键都按 step 移动，而每一次写入都会先被夹取到 [min, max] 之内，然后才交给回调看到。",
            "The same 12.5 in three fields: decimals 0 rounds to 13, decimals 1 keeps 12.5 and decimals 2 pads to 12.50. The rounding happens on every write, including the value the author passed in, so the model and the box never disagree.": "同样是 12.5，放进三个字段：decimals 为 0 时四舍五入成 13，decimals 为 1 时保持 12.5，decimals 为 2 时补零成 12.50。每一次写入都会做舍入，包括作者传进来的那个值，所以模型和框里的显示永远不会打架。",
            "The same contract as the checkbox": "与复选框相同的契约",
            "The three buttons below are the same kind; the row supplies the position. That is the whole reason a footer needs no widget: `justifyContent: flex-end` on a row of declared widths lines up right edges without measuring anything.": "下面三个按钮是同一种 kind；位置由 row 提供。这正是页脚不需要专门控件的原因：在一个声明了宽度的 row 上使用 `justifyContent: flex-end`，不必测量任何东西就能对齐右边缘。",
            "The two columns below are different subtrees; the radios still exclude each other because the group is the string \"side\", not the parent. A widget-tree group would have forced both columns into one node just to share a selection.": "下面两列属于不同的子树；两个单选按钮依然互斥，因为分组是字符串 `side`，而不是父节点。若按控件树分组，为了让它们共享一次选中，就得把两列硬塞进同一个节点。",
            "The two fields below sit ON min and max. The steppers, the arrow keys and a typed commit all stop there before any callback runs, so a handler never has to clamp: what arrives is already in range.": "下面两个字段正好停在 min 和 max 上。步进按钮、方向键和键入后的提交，都会在任何回调运行之前停在那里，所以处理器永远不必自己夹取：送到手上的值已经在范围内。",
            "The value is a Number in the model; the widget reports a new one on drag. The label is the slider's own first argument, not a separate text node.": "值是模型里的一个 Number；拖动时控件上报一个新值。标签是滑块自己的第一个参数，而不是一个单独的文本节点。",
            "The widget's first argument is a LABEL it draws itself, in the same run as the track -- there is no separate text node to align. When the design wants the name above the track instead, pass an empty label and put the text in a column: the widget then reserves no label line at all.": "控件的第一个参数是它自己绘制的标签，与滑轨在同一段文本里排布——没有单独的文本节点需要对齐。如果设计要求把名称放到滑轨上方，就传一个空标签，并把文字放进 column：这样控件就完全不预留标签行。",
            "There is one button kind. Primary / quiet / danger are three style refinements, not three widgets, so a variant never drifts from the base behaviour.": "按钮只有一种。Primary / quiet / danger 是三种样式修饰，而不是三个控件，因此某个变体永远不会偏离基础行为。",
            "Three independent booleans": "三个彼此独立的布尔值",
            "Three switches, two hairlines, one card. The rows are not a widget: a card whose children alternate toggle and divider. Everything left/right in it is the card's padding, so the block moves as one if the padding changes.": "三个开关、两条细线、一张卡片。这些行本身不是一个控件：就是一张卡片，它的子节点在 toggle 与 divider 之间交替。其中所有左右方向的间距都来自卡片的 padding，因此 padding 一旦变化，整块内容会作为一个整体移动。",
            "Two legal extremes: 0..1 fills the whole track, and 0.4..0.4 collapses to a single position with the two thumbs on top of each other. Neither is a special case in the code -- the band is drawn between the two positions it was given.": "两个合法的极端情形：0..1 填满整条轨道，0.4..0.4 则收缩为单一位置、两个滑块重叠在一起。这两者在代码里都不是特例——色带只是画在它被给定的两个位置之间。",
            "Two thumbs, one track": "两个滑块，一条轨道",
            "Typing commits; junk reverts": "输入即提交；无效内容回退",
            "Variants are styles": "变体就是样式",
            "With no height in the style the box is `rows` REAL line heights of the resolved font (measured with the field itself, not a constant), plus padding and border. There is no Enter-to-commit here, so onCommit fires when focus leaves the field.": "样式里不给高度时，框体高度就是解析后字体的 `rows` 个真实行高（用字段自身测量，而不是某个常量），再加上 padding 与边框。这里没有回车提交，所以 onCommit 在焦点离开该字段时触发。",
            "`disabled` is an Element field, so every factory accepts it and the kit drops the hover/press modulation and the handler in one place (see UiNode.inert).": "`disabled` 是 Element 的字段，所以每个工厂函数都接受它，而组件库在一处就同时去掉 hover/press 调制与事件处理器（见 UiNode.inert）。",
            "`step` does not quantise the drag (the thumb follows the pointer 1:1); it is how far an arrow key moves the focused thumb. It must be positive -- the factory throws otherwise, because a zero step would make every arrow key a silent no-op.": "`step` 不会对拖拽做量化（滑块 1:1 跟随指针）；它是方向键每次移动聚焦滑块的幅度。它必须为正——否则工厂函数会抛出异常，因为 step 为 0 会让每次方向键操作都变成无声的空操作。",
            "`tabEnabled: false` keeps a button out of the tab walk.": "`tabEnabled: false` 让按钮不参与 Tab 遍历。",
            "decimals decides how many digits you see": "decimals 决定你看到几位数字",
            "onChange fires on every accepted change, onCommit on Enter or on blur. Text that does not parse is REVERTED to the model -- never NaN, never 0 -- because a number field that invented a value would silently overwrite what the author stored. decimals rounds every write, including the value the author passed in.": "onChange 在每次被接受的变更时触发，onCommit 在回车或失焦时触发。无法解析的文本会被回退到模型里的值——绝不会是 NaN，也绝不会是 0——因为一个凭空编造数值的数字字段会悄悄覆盖作者存储的内容。decimals 会对每一次写入做舍入，包括作者传入的那个值。",
            "onChange fires per keystroke and onCommit on Enter/blur. A page that writes the model on every keystroke re-renders the whole page -- fine here, wasteful in a form.": "onChange 每按一次键就触发，onCommit 在回车/失焦时触发。每次按键都写模型的页面会整页重渲染——在演示页里没问题，在表单里就很浪费。",
            "password:true masks the display and leaves the MODEL string alone, so the value you commit is the real one.": "password:true 只遮罩显示，不改动 MODEL 里的字符串，所以你提交的值就是真实值。",
            "rows sets the height; commit is on blur": "rows 决定高度；提交发生在失焦时",
            "rows:3 is the HEIGHT of the box, not a limit on the text. The value below is eight lines; the field is three line-heights tall and scrolls, and the caret walking past the bottom scrolls the view with it.": "rows:3 是框体的高度，而不是对文本的限制。下面的值是八行；字段只有三个行高那么高并且会滚动，光标走过底部之外时视图会随之滚动。",
            "step is the keyboard increment": "step 是键盘步进幅度",
            "value and value2 are clamped into 0..1 and SWAPPED when they arrive backwards, at construction time. Doing that in the widget instead would leave the first painted frame -- the one before any interaction -- showing an inverted band.": "value 与 value2 在构造时会被夹取到 0..1，并且当它们顺序颠倒时会互相交换。若改在控件内部做这件事，第一帧绘制——也就是任何交互之前的那一帧——就会显示一条颠倒的色带。",

            // ---- DocsData.as
            "A FINGER on a touch screen scrolls this pane 1:1 and keeps going after it lifts (`momentum`, default true; `decelerationRate`, default 0.95 per 60Hz frame); a finger landing on a gliding pane stops it. It is not demonstrable here: this window's backend produces no touch events at all (compiler-gaps.md G5), so on a desktop this pane is wheel and thumb only -- and the WHEEL and the THUMB stop dead at the end on every platform, on purpose.": "触摸屏上的手指以 1:1 滚动这个面板，抬手后仍会继续滑行（`momentum` 默认 true；`decelerationRate` 默认 0.95，按 60Hz 每帧计）；手指落在正在滑行的面板上会让它停下。这里无法演示：本窗口的后端完全不产生触摸事件（compiler-gaps.md G5），所以在桌面端这个面板只有滚轮和滑块——而且滚轮和滑块在所有平台上都会在末尾戛然而止，这是刻意的。",
            "A bar appears where the content overflows: drag the thumb, or click the track to page by one viewport. `scrollbarGutter` decides where it sits: `\"overlay\"` (the default) paints the bar over the content and changes no rect, `\"stable\"` reserves its lane so the content stops short of it -- which is what this page does: its cards end where the bar begins.": "内容溢出之处才会出现滚动条：拖动滑块，或点击轨道按一个视口翻页。`scrollbarGutter` 决定它占据的位置：`overlay`（默认）把滚动条画在内容之上、不改变任何矩形，`stable` 为它保留一条专属通道，内容到此为止——本页正是这样：它的卡片正好在滚动条开始处结束。",
            "A branch's children become rows of the SAME node while it is open, so there is no nested container and no recursive reconciliation -- depth is a padding, not a parent.": "分支展开时，它的子项会成为同一个节点的行，因此既没有嵌套容器，也没有递归协调——深度体现为内边距，而不是父容器。",
            "A clipped viewport": "被裁剪的视口",
            "A column without a width shares whatever is left, and every cell in a column carries the SAME style pointer, so alignment is the engine's job, not arithmetic.": "未指定宽度的列会分得剩余的空间，而且同一列中的每个单元格都共享同一个样式指针，所以对齐是引擎的职责，而不是算术的职责。",
            "A finger is the only thing that overscrolls: past an end it stretches against a damped resistance and springs back on release (`overscroll`, default \"rubber\"; \"none\" for a pane that must not move). The author-facing `offsetY` stays inside the range throughout -- the stretch is reported separately as `overscrollY`.": "只有手指会产生越界滚动：越过某一端之后，它会克服带阻尼的阻力被拉伸，松手时弹回（`overscroll` 默认取 rubber；对于不允许移动的面板取 none）。面向作者的 `offsetY` 全程保持在有效区间内——拉伸量另行通过 `overscrollY` 上报。",
            "A flattened hierarchy": "扁平的层级",
            "A list is a SEQUENCE, the ARIA listbox shape, so the ends CLAMP: Down on the last row stays there and still CONSUMES the key, which is what stops the press from falling through to whatever scrolls the page.": "列表是一个序列，形状对应 ARIA 的 listbox，所以两端会夹紧：在末行按向下键仍停在末行，并且按键依然被消费掉，正是这一点阻止该按键继续下传、去滚动页面。",
            "A scrollView clips and slides its child, which therefore needs an explicit height: a container that measured itself would leave nothing to scroll.": "scrollView 会裁剪并平移它的子节点，因此子节点需要一个明确的高度：如果容器自己测量尺寸，就没有任何可滚动的内容了。",
            "A selected-row change raises only a paint dirty bit: the rows keep their rects, so selecting never re-solves layout. The widget paints the band behind the rows.": "选中行的变化只会置起一个重绘脏标记：各行保持原有矩形，所以选中永远不会重新求解布局。组件把选中带画在行的后面。",
            "A sparkline is 5..60 numbers and a rectangle -- the shape of a day, not a chart.": "sparkline 就是 5..60 个数字加一个矩形——画一天的走势形态，而不是做一张图表。",
            "A tree flattens to a row array first (one row per visible item, branches only while open) and then mounts the window like a list, so rows.length is still the FULL flattened count: an absolute index keeps working after a scroll, and a key that moves the highlight off the window scrolls it back into view by itself.": "tree 先把层级拍平成行数组（每个可见项一行，分支只在展开时出现），然后像列表一样挂载窗口，所以 rows.length 仍然是拍平后的完整数量：绝对下标在滚动之后依然有效，而一个把高亮移出窗口的按键会自己把该行滚回视野。",
            "A virtual table reveals the row it selects": "虚拟表会把选中的那一行显示出来",
            "Cells come from cellText": "单元格内容来自 cellText",
            "Column widths are yours": "列宽由你掌握",
            "Columns and rows": "列与行",
            "Depth is padding, not a nested box": "深度是内边距，不是嵌套盒子",
            "Drag the divider in the header: a 1px preview line follows the pointer and, on release, `onColumnResize(index, width)` fires ONCE. The widget never writes into your `columns` array -- it is usually an inline literal rebuilt every render, so a width written there would vanish on the next pass.": "拖动表头中的分隔线：一条 1px 的预览线跟随指针，松开时 `onColumnResize(index, width)` 只触发一次。组件从不写入你的 `columns` 数组——它通常是每次渲染都重建的内联字面量，写进去的宽度在下一轮就会消失。",
            "Expanding or collapsing changes rows.length, so the factory re-snaps offsetY.": "展开或折叠会改变 rows.length，因此工厂函数会重新对齐 offsetY。",
            "Expansion is the author's": "展开由作者决定",
            "Four levels open at once: every visible branch child is a ROW of the same node, indented by its depth. So a deep tree has the same node count as a flat list of the same length -- and a selection is still one key, not a path to walk.": "同时展开四层：每个可见的分支子项都是同一个节点的行，并按它的深度缩进。因此一棵深树的节点数量与同等长度的扁平列表相同——而选中依然只是一个 key，不是一条要走完的路径。",
            "Grid lines instead of stripes": "用网格线代替斑马纹",
            "It is honoured when the VALUE CHANGES, so a re-render that still carries it does nothing -- otherwise every frame would yank the list back. To jump to the same row twice, pass -1 in between (or any value that is not an index).": "只有当值发生变化时它才生效，所以一次仍携带同一值的重新渲染什么也不做——否则每一帧都会把列表拽回去。要连续两次跳到同一行，中间先传 -1（或任何不是下标的取值）。",
            "It refuses separator: true (a hairline changes the row pitch, so the window would drift one row per screen) and an auto height (the window has to know the size BEFORE layout runs).": "它会拒绝 separator: true（一条细线会改变行距，于是窗口每屏会漂移一行）以及自动高度（窗口必须在布局运行之前就知道尺寸）。",
            "Items become rows": "条目变成行",
            "Keyboard: arrows, Home/End, PageUp/PageDown": "键盘：方向键、Home/End、PageUp/PageDown",
            "Keyboard: the arrows move the selection": "键盘：方向键移动选中项",
            "Logs that follow their end": "跟随末尾的日志",
            "Mutated in place": "原地修改数据",
            "One formatter maps a row object to the string for a column -- so a number, a status or a date is formatted in one place, and the table stays a layout object.": "一个格式化函数把行对象映射为某一列要显示的字符串——于是数字、状态或日期只在一处格式化，而表格依然是一个布局对象。",
            "One series in a box": "框里的一段系列数据",
            "One wheel notch is `wheelStep` px; with nothing to scroll vertically, the wheel falls back to the horizontal axis.": "滚轮一格是 `wheelStep` px；纵向没有可滚动的东西时，滚轮回落到横轴。",
            "Only the visible rows exist": "只有可见的行存在",
            "Press \"Focus it\", then Up / Down / Home / End. A key goes to whatever holds FOCUS, and AIR does not focus a plain Sprite on mouseDown -- only a TextField is focused by a click -- so a widget is reached with Tab (list sets tabEnabled) or, as here, programmatically.": "先按「Focus it」，再按 上 / 下 / Home / End。按键会送给持有焦点的那个对象，而 AIR 在 mouseDown 时不会聚焦一个普通 Sprite —— 只有 TextField 会因为一次点击而获得焦点 —— 所以控件要靠 Tab 才能走到（list 会把 tabEnabled 置上），或者像这里一样用编程方式走到。",
            "Press Down and watch the offset start stepping once the window edge is reached; End jumps to the last of the two hundred rows, and the offset to the very bottom.": "按下 下 方向键：一旦触到窗口边缘，offset 就开始一格格向前走；End 会跳到这两百行中的最后一行，offset 也跟到最底部。",
            "Re-renders never steal the reader's place: a description that does not name an offset leaves the viewport where it is, however often the page re-describes itself. Name one -- `offsetY: 0` from a BACK-TO-TOP button -- and it IS a request, honoured whenever it differs from where the view is. That is also the trade: if you declare an offset, mirror it from `onScroll`, or every re-render will take the reader back to the number you declared.": "重新渲染永远不会夺走读者所在的位置：一个不提 offset 的描述，会让视口停在原处，不管页面自我描述多少次。写出一个 —— 比如 BACK-TO-TOP 按钮给出的 `offsetY: 0` —— 它就是一次请求，只要与当前视口不同就会被执行。这也是代价所在：一旦声明了 offset，就必须从 `onScroll` 把它镜像回来，否则每次重新渲染都会把读者带回你声明的那个数字。",
            "Row keys are ABSOLUTE (r0, r1, ...), so a window that shifts mounts genuinely new nodes instead of handing a scrolled-in row the node of the row that just left.": "行 key 是绝对的（r0, r1, ...），所以窗口平移时挂载的是真正全新的节点，而不是把刚离开那一行的节点交给滚进来的那一行。",
            "Same contract as the list, plus a PAGE step, which moves by the rows the BODY can show rather than by one. The selection is always a data row: the header is not a row and can never be selected, so Home goes to the first row under the header, not to the header.": "与 list 相同的契约，另加一次 PAGE 步进：它按 BODY 能显示的行数移动，而不是按一行。选中项永远是一条数据行：表头不是行，永远不能被选中，所以 Home 会走到表头下面的第一行，而不是表头。",
            "Say NOTHING about the offset and no re-render will move this pane.": "对 offset 什么都不说，就没有任何一次重新渲染会挪动这个面板。",
            "Scroll up and it lets go immediately (one pixel off the end is a reader, not a rounding error); scroll back down and it re-attaches, because the rule is re-derived from the live offset every frame rather than kept in a stuck flag.": "往上滚，它立刻放手（离末尾还差一个像素算是在阅读，不是舍入误差）；再往下滚回去，它又自动接上，因为这条规则是每一帧从当前 offset 重新推导出来的，而不是存在某个卡住的标志位里。",
            "Scrollbars on both axes": "两个轴上都有滚动条",
            "Scrolling reports a row-aligned offset; writing it back re-renders, and the reconciler mounts exactly the rows that entered the window.": "滚动上报的是按行对齐的 offset；把它写回去就会重新渲染，协调器恰好只挂载真正进入窗口的那些行。",
            "Selection is a decoration": "选中只是一层装饰",
            "So a row is an ordinary Node (a text, a row of chips, anything).": "所以一行就是一个普通的 Node（一段文本、一排 chip，什么都可以）。",
            "Sorting: the model owns the order": "排序：顺序归模型所有",
            "The auto-scroll is a real move: `onScroll` fires and `offsetY` is written back, so your model never disagrees with the screen.": "自动滚动是一次真实的移动：`onScroll` 会触发、`offsetY` 会被写回，所以你的模型永远不会和屏幕对不上。",
            "The bars are the author's: `barThickness`, `barColor`, `barHoverColor` and `trackColor`. `never` hides one axis entirely without changing the layout.": "滚动条归作者所有：`barThickness`、`barColor`、`barHoverColor` 和 `trackColor`。`never` 会把某一个轴整体藏起来，同时不改动布局。",
            "The builder runs once per item per render, at factory time -- not per mounted row.": "构建函数对每个 item、每次渲染只跑一次，在工厂函数阶段 —— 而不是对每个已挂载的行各跑一次。",
            "The click that the window sends after a release is swallowed, so resizing a column never also sorts it.": "松手之后窗口补发的那次点击会被吞掉，所以调整列宽永远不会顺手触发排序。",
            "The cycle is the browser's: another column sorts ascending, the same column descending, and a third click reports -1 (unsorted). Numbers compare as numbers while text compares as text, which is what makes a Qty column sort 1, 2, 10.": "这个循环是浏览器的习惯：换一列就升序，同一列就降序，第三次点击上报 -1（未排序）。数字按数字比较、文本按文本比较，这正是 Qty 列排出 1、2、10 的原因。",
            "The four knobs": "四个旋钮",
            "The widget reports which rows it mounted, so a list backed by a paged request can fetch the page it is about to need. The pair below is written by the list itself, not computed by the page.": "控件会上报它挂载了哪些行，所以一个由分页请求支撑的列表可以提前取它马上要用的那一页。下面这一对值由列表自己写入，而不是由页面计算得出。",
            "There is no second copy of the selection: a key calls the same select() a click calls.": "选中状态没有第二份副本：按键调用的是和点击同一个 select()。",
            "Two mistakes throw loudly at factory time: passing something that is not an Array, and a strokeWidth that is not positive. A short series is not an error -- fewer than two samples is a line with nothing to connect, so the box stays empty rather than inventing a flat segment at zero.": "两种错误会在工厂函数阶段大声抛出：传进来的东西不是 Array，以及 strokeWidth 不是正数。系列太短不算错误 —— 少于两个样本就是一条没有东西可连的线，所以框保持为空，而不是在 0 处凭空造出一段平线。",
            "Virtual: mount only what shows": "virtual：只挂载看得见的部分",
            "What it refuses, and what it just does not draw": "它拒绝什么，以及它只是不画什么",
            "Wheel it": "滚一下滚轮",
            "Wheel, thumb, track": "滚轮、滑块、轨道",
            "Where it starts, and what the bars look like": "它从哪里开始，以及滚动条长什么样",
            "With virtual: true only the mounted window exists, so a key can select a row that is not on screen: the index is valid, the model moved, and NOTHING changed -- a state no property assertion can see. So the widget REVEALS it: it reports the offset that brings the row into the window through onScroll, and the next render mounts it there.": "在 virtual: true 下只有已挂载的那一窗存在，所以按键可以选中一条不在屏幕上的行：索引有效、模型动了，而屏幕上什么都没变 —— 这是一种任何属性断言都看不见的状态。所以控件会把它揭示出来：它通过 onScroll 上报那个能把该行带进窗口的 offset，下一次渲染就会把该行挂载在那里。",
            "`color` defaults to the resolved text colour; `fill` tints the area under the line, `dot` marks the newest sample, and the box is whatever size you give it.": "`color` 默认取解析后的文本颜色；`fill` 会给线下的区域着色，`dot` 标出最新的那个样本，而框的大小就是你自己给的大小。",
            "`fill` tints the area (13%), `dot` is the live cue, `baseline` draws a faint rule at a value -- typically the previous close -- and joins the y range so the rule and the line cannot disagree about where flat is. `strokeWidth` is a point size.": "`fill` 会给区域着色（13%），`dot` 是实时提示，`baseline` 在某个值处画一条淡线 —— 通常是前收盘价 —— 并把它并入 y 轴范围，这样那条基准线和折线就不会对「哪里算平」各执一词。`strokeWidth` 是以点（pt）为单位的尺寸。",
            "`grid: true` draws the row rules and the column rules in the table's border colour; `stripes` paints every other row instead. They compose (both on is a spreadsheet look) but on a tight row height the rules are usually enough -- and a rule is drawn INSIDE the row, so it never changes a row's height.": "`grid: true` 会用表格（table）的边框颜色画出行线和列线；`stripes` 则改为给每隔一行上色。两者可以叠加（同时开启就是电子表格的样子），但在紧凑的行高下，光有线通常就够了 —— 而且线是画在行内部的，所以它永远不会改变行高。",
            "`offset` (or `offsetX` / `offsetY`) is the view's top-left in CONTENT coordinates, so a restored scroll position needs no scrolling and no frame with the wrong offset on screen. It is clamped to the real range.": "`offset`（或 `offsetX` / `offsetY`）是视口左上角在内容坐标系中的位置，所以恢复滚动位置时既不需要滚动，也不会有一帧显示出错误的 offset。它会被夹紧到真实范围内。",
            "`onSort(column, descending)` reports an INTENT and nothing else -- the widget never reorders your rows. `sortColumn` is the order you hand back, and the arrow is drawn from it, so the header can never claim an order the rows do not have.": "`onSort(column, descending)` 上报的只是一种意图，别的什么都不做 —— 组件从不重排你的行。`sortColumn` 是你回传的顺序，箭头就按它来画，所以表头永远不会声称一个行并不具备的顺序。",
            "`onVisible(first, last)` says which rows are mounted (the lazy-loading hook); `scrollToIndex` is a ONE-SHOT request: it is honoured when the value CHANGES, so a re-render that still carries it does nothing -- and asking for the same row twice means passing -1 in between (the row was already the target).": "`onVisible(first, last)` 说明哪些行已挂载（惰性加载的钩子）；`scrollToIndex` 是一次性请求：只有当值发生变化时它才生效，所以一次仍携带同一值的重新渲染什么也不做 —— 而要连续两次请求同一行，得在中间传一次 -1（那一行本来就已经是目标了）。",
            "`stickToBottom` makes the view follow the END of its content as it grows -- a chat or a console. A fresh view counts as being at the end, so a log opens on its newest line rather than its oldest.": "`stickToBottom` 让视口随着内容增长而跟随它的末尾 —— 比如一个聊天窗口或一个控制台。全新的视口算作已经在末尾，所以日志打开时停在最新那一行，而不是最早那一行。",
            "`values` is kept BY REFERENCE and compared by identity, so a steady frame costs one pointer test and the widget never copies the data. An author who edits the array in place must say so with `version` -- that bump is the only thing that tells the node the line moved. A fresh array every render needs no version at all.": "`values` 按引用保存、按同一性比较，所以稳定的一帧只花一次指针判断，组件也从不复制数据。就地修改数组的作者必须用 `version` 说明这一点 —— 这一次递增是唯一能告诉节点「线动了」的东西。每次渲染都换一个新数组的话，则完全不需要 version。",
            "`virtual` mounts the visible window plus one partial row that the clip hides -- the rest of the model never becomes a node. It needs a POINT height (the body is `height - rowHeight`) and `onScroll(offsetY)`, which reports the new offset for you to re-render with; the header does not scroll.": "`virtual` 会挂载可见窗口，外加一行被裁剪遮住的部分行 —— 模型的其余部分永远不会变成节点。它需要一个确定的点值高度（主体是 `height - rowHeight`）和 `onScroll(offsetY)`，后者上报新的 offset 供你重新渲染；表头不滚动。",
            "count 10000 and nine mounted rows: the window is row-granular and the factory recomputes it, so scrolling mounts and unmounts rows like any other reconcile.": "count 设为 10000 而只挂载九行：窗口以行为粒度，工厂函数会重新计算它，所以滚动就像任何其他协调过程一样挂载和卸载行。",
            "onToggle reports the key; nothing expands by itself. The kit keeps the rule that a widget never owns state the reconciler cannot re-describe.": "onToggle 上报的是 key；没有任何东西会自己展开。这套组件守住一条规则：组件永远不会持有协调器无法重新描述的状态。",
            "onVisible is the lazy-load hinge": "onVisible 是惰性加载的铰链",
            "scrollToIndex is a one-shot request": "scrollToIndex 是一次性请求",
            "virtual turns the list into a WINDOW: the factory mounts ceil(height / itemHeight) rows plus one (the partial row at the bottom is real), and it must be told which row the window starts on. offsetY is that start, row-aligned; onScroll hands you the next one -- the author stores it and re-renders, the same contract as virtualList and table. selectedIndex stays an ABSOLUTE index, not a window one.": "virtual 把列表变成一个窗口：工厂函数会挂载 ceil(height / itemHeight) 行再加一行（底部那一行部分可见的行是真实存在的），而且必须告诉它窗口从哪一行开始。offsetY 就是这个起点，按行对齐；onScroll 会把下一个起点交给你 —— 作者把它存起来并重新渲染，这与 virtualList 和 table 是同一套契约。selectedIndex 仍然是绝对下标，而不是窗口内的下标。",
            "virtual: true -- only the window exists": "virtual: true —— 只有窗口存在",
            "virtual: true -- the same window, over rows": "virtual: true —— 同一套窗口，作用在行上",

            // ---- DocsFeedback.as
            "A BitmapData in a box": "方框中的 BitmapData",
            "A bubble with an arrow": "带箭头的气泡",
            "A determinate bar": "确定值的进度条",
            "A glyph from path data": "由路径数据绘制的字形",
            "A skeleton reserves the space the real content will take, so the page does not jump when the data arrives. `variant` picks text / circle / rect.": "骨架屏会预留真实内容将要占用的空间，因此数据到达时页面不会跳动。`variant` 用于选择 text / circle / rect。",
            "A spinner is sized by `diameter` and stroke `thickness`; `phase` turns it, and the app's frame loop is what keeps the phase moving.": "spinner 的尺寸由 `diameter` 和描边 `thickness` 决定；`phase` 让它转动，而真正让这个相位持续移动的是应用的帧循环。",
            "A tooltip is a static leaf: place it, do not hover it. Hover behaviour is the author's (show it from a model flag), because the timing policy is not universal.": "tooltip 是静态叶子节点：你去放置它，而不是去悬停它。悬停行为由作者负责（依据模型中的标志把它显示出来），因为时机策略并不是通用的。",
            "An empty label is a bare bar": "空标签就只剩一条进度条",
            "An icon is SVG path data (`d` syntax) drawn into its box, so it has no file, no texture and no second copy per colour -- it takes the colour and the size it is given and stays sharp at any scale. With no `size`, the box IS the `viewBox` (24 by default), which is the convention every public icon set is authored in.": "icon 就是把 SVG 路径数据（`d` 语法）绘制到它的方框中，所以它没有文件、没有纹理，也不会为每种颜色存第二份副本 —— 它接受给定的颜色与尺寸，并在任何缩放下都保持锐利。不提供 `size` 时，方框本身就是 `viewBox`（默认 24），这也是每一个公开图标集在制作时所遵循的约定。",
            "An indeterminate ring": "不确定进度的圆环",
            "At 0 the track is still drawn -- an empty bar says \"started, nothing yet\", which is not the same message as no bar at all. At 1 the fill reaches the end and stops; it does not overshoot or switch to a second state.": "取值为 0 时轨道仍会被绘制出来 —— 一条空的进度条表示「已开始，尚无进展」，这与完全没有进度条所传达的信息并不相同。取值为 1 时填充到达末端便停止；它不会越过终点，也不会切换到第二种状态。",
            "Beside a label": "位于标签旁边",
            "Both images below are the same 8x8 gradient drawn at 12x.": "下面两张图都是同一张 8x8 的渐变图按 12 倍绘制的。",
            "Disabled dims it, and stops the loop": "禁用状态会使其变暗，并停止循环",
            "Driven by the model": "由模型驱动",
            "Four arrows, one bubble": "四个箭头，同一个气泡",
            "From a file or a URL": "来自文件或 URL",
            "Frozen, and where the gap sits": "冻结状态，以及缺口所在的位置",
            "In a row with its anchor": "与它的锚点同处一行",
            "It has no intrinsic margin: spacing is the row's `gap`, like every other leaf.": "它没有固有的外边距：间距来自所在行的 `gap`，与其他所有叶子节点一样。",
            "It is a placeholder, not a shimmer": "它是占位符，不是微光动画",
            "No arrow, no gap to fill": "没有箭头，也就没有要填补的缺口",
            "Nothing animates on its own: a task that advances writes the value and invalidates.": "没有任何东西会自行播放动画：推进中的任务会写入数值并触发重绘。",
            "One source (a 16x8 two-tone band), one 96x96 box, both modes below.": "同一个源（一段 16x8 的双色带），同一个 96x96 的方框，两种模式见下。",
            "Placeholders that match the layout": "与布局相匹配的占位符",
            "Rect": "矩形",
            "Scale modes": "缩放模式",
            "Stroke width is a viewBox width": "描边宽度是 viewBox 空间中的宽度",
            "That keeps the frame cost at \"one repaint\" and makes the demo's evidence exact.": "这样就把每帧成本维持在「一次重绘」，也让演示中的证据变得精确。",
            "The arrow names the side the anchor is on: `down` means the bubble sits above its anchor, `up` below it, and left/right sit beside. Placement is still the author's -- the widget draws the notch, not the float.": "箭头指明锚点位于哪一侧：`down` 表示气泡在锚点之上，`up` 表示在锚点之下，left/right 则位于其旁侧。放置位置仍由作者决定 —— 控件只绘制这个缺口，不负责浮动定位。",
            "The arrow points at the anchor; the bubble's own size comes from its text, so it never needs a width.": "箭头指向锚点；气泡自身的尺寸来自它的文本，因此永远不需要指定宽度。",
            "The clip is a `scrollRect` on the bitmap, and the window is in the BITMAP's own units: the renderer clips through the object's own matrix, so a window measured in box pixels is a window divided by the scale factor too -- the first version asked for a box-sized window on a 3x picture and cropped to nothing. Leaving cover CLEARS the window, because a stale crop is invisible right up until the next mode inherits it.": "裁剪是位图上的一个 `scrollRect`，而窗口用的是位图自身的单位：渲染器通过对象自身的矩阵来裁剪，所以在盒子像素下量出的窗口，同样还要除以缩放系数——第一个版本在一张 3 倍图上要求了一个盒子大小的窗口，结果裁得什么都不剩。离开 cover 模式会清除窗口，因为残留的裁剪在下一个模式继承它之前是完全看不见的。",
            "The ends are real states": "两端是真实状态",
            "The image scales a bitmap into the box it was given; `scaleMode` picks how. Keep the BitmapData STABLE across renders -- a new one every frame would re-upload the texture.": "图像把位图缩放放进它被给定的盒子；`scaleMode` 决定怎么缩放。请让 BitmapData 在多次渲染之间保持稳定——每帧换一个新的都会重新上传纹理。",
            "The label is optional: pass the empty string and the widget reserves no label line at all, which is what an inline progress bar under a table row wants. The percentage in the label above is an expression the page wrote, not a format the widget owns.": "标签是可选的：传入空字符串时，控件完全不预留标签行，这正是表格行下方那种内联进度条所需要的。上方标签里的百分比是页面自己写的表达式，不是控件内置的格式。",
            "The rect variant is what a media card's thumbnail uses -- a fixed block that keeps the column's height stable while the image loads.": "rect 变体正是媒体卡片缩略图所用的——一个固定块，在图像加载期间保持列高稳定。",
            "The tone is the fill": "tone 就是填充色",
            "There are four: `fit` contains the picture and pads (the default), `stretch` fills the box and ignores the aspect, `none` draws it 1:1, centred, and `cover` fills the box and CROPS. An unknown mode THROWS at describe time -- a silent fallback to `fit` would leave a picture the wrong size with nothing on screen saying why. `letterbox` and `zoom` throw too: both used to fall into the contain branch, so `zoom` (which reads as cover) did not zoom at all.": "共有四种：`fit` 容纳整张图片并留白（默认值），`stretch` 填满盒子且忽略宽高比，`none` 按 1:1 居中绘制，`cover` 填满盒子并裁剪。未知模式在描述阶段就会抛错——静默回退到 `fit` 只会留下一张尺寸不对的图片，而屏幕上没有任何东西说明原因。`letterbox` 与 `zoom` 也会抛错：这两个值过去都会落进 contain 分支，于是 `zoom`（字面读作 cover）根本没有缩放。",
            "There is no animated shine: a shimmer would repaint the block every frame for as long as the data is missing, and the frame budget is the one resource this kit refuses to spend on decoration. The card below is five leaves and one column.": "这里没有动态闪光：只要有数据缺失，微光效果就会每帧重绘这个块，而帧预算正是这套组件库绝不肯花在装饰上的那一样资源。下面的卡片是五个叶子加一个列。",
            "Unknown commands throw too, at the call site: `icon()` parses its data when you describe it, so the stack frame is the line you wrote.": "未知命令同样会在调用点抛错：`icon()` 在你描述它的时候就会解析数据，所以堆栈帧就是你写下的那一行。",
            "What it will not draw": "它画不出来的东西",
            "`M L H V Z` are exact, `Q T` are exact, and `C S` are converted: this engine has a quadratic `curveTo` and no cubic, so each cubic is split until the quadratics are within a quarter of a rendered pixel of it. An elliptical arc (`A`) THROWS -- an arc is not a curve this engine can draw without going through a cubic, and quietly drawing a chord instead would be an icon that looks fine and is the wrong shape.": "`M L H V Z` 是精确的，`Q T` 是精确的，`C S` 则要转换：这个引擎只有二次的 `curveTo`，没有三次曲线，所以每条三次曲线都会被切分，直到这些二次曲线与它的偏差落在渲染后像素的四分之一以内。椭圆弧（`A`）会抛错——弧不是这个引擎不经由三次曲线就能画出的曲线，而悄悄改用弦来代替，只会得到一个看起来没问题、形状却错误的图标。",
            "`arrow: none` is the plain bubble -- what a keyboard-shortcut hint beside a menu item wants, where an arrow pointing at nothing would be noise.": "`arrow: none` 是纯气泡——菜单项旁边的键盘快捷键提示正需要它，因为在那种场合一支指向空处的箭头只会是噪音。",
            "`arrow` is up | down | left | right | none, and `tone` is the bubble's FILL colour.": "`arrow` 取值为 up | down | left | right | none，`tone` 是气泡的填充色。",
            "`cover` scales until the picture COVERS the box and clips the overflow -- the opposite of `fit`, which contains the whole picture and pads. Both keep the aspect ratio; only one of them may throw pixels away.": "`cover` 一直缩放，直到图片覆盖整个盒子，然后裁掉溢出部分——与 `fit` 正好相反，后者容纳整张图片并留白。两者都保持宽高比；只有其中一个会丢弃像素。",
            "`disabled` is generic, so a disabled spinner is drawn at the disabled alpha -- and because the widget only runs its ENTER_FRAME while it spins, a frozen disabled ring costs nothing per frame either.": "`disabled` 是通用选项，所以禁用的 spinner 会按禁用态透明度绘制——而且因为控件只在旋转时运行它的 ENTER_FRAME，一个冻结的禁用圆环每帧也不花任何代价。",
            "`phase` (0..1) is the gap's position around the ring, which is why three frozen spinners can look like three different instants of one animation.": "`phase`（0..1）是缺口在圆环上的位置，这就是为什么三个冻结的 spinner 看起来像同一段动画的三个不同瞬间。",
            "`smooth: true` (the default) lets the renderer interpolate; `smooth: false` asks for nearest neighbour, which is what pixel art, sprite sheets and 1-bit masks need -- blurring a mask turns a crisp edge into a grey halo.": "`smooth: true`（默认值）让渲染器做插值；`smooth: false` 则要求最近邻，这正是像素画、精灵表与 1 位掩码所需要的——把掩码模糊掉会把干脆的边缘变成一圈灰色晕影。",
            "`spin: false` stops the rotation -- the widget owns an ENTER_FRAME while it spins and none while it does not, so freezing it also stops the per-frame work.": "`spin: false` 停止旋转——控件在旋转时持有一个 ENTER_FRAME，不旋转时不持有，所以把它冻结也就一并停掉了逐帧的工作。",
            "`src` hands the loading to the widget: it owns a Loader, so the author writes no COMPLETE wiring and no torn-down-node guard. The path is resolved by the RUNTIME (relative to the process's working directory), and a load is ASYNC: until it lands the box is the 64x64 placeholder, so give an auto-sized image a `size` if it must not jump. A failure is not silent -- `onLoad()` takes nothing, `onError(message)` takes the IOError text, and `UiNode.loadError` keeps it on the node.": "`src` 把加载交给控件：控件自己持有一个 Loader，所以作者不必写 COMPLETE 事件接线，也不必写节点被拆掉时的守卫。路径由运行时解析（相对于进程的工作目录），而加载是异步的：在它落地之前，盒子就是 64x64 的占位块，所以对于自动尺寸的图像，如果它不能跳动，就给它一个 `size`。失败不会是静默的——`onLoad()` 不带参数，`onError(message)` 接收 IOError 的文本，`UiNode.loadError` 把它留在节点上。",
            "`strokeWidth` is in the data's own units, so it scales with the glyph: the same glyph at 24 and at 48 has a 2px and a 4px outline. That is what the source SVG means by `stroke-width`, and it is why an icon stays legible when it is scaled up.": "`strokeWidth` 以数据自身的单位计，所以它会随字形一起缩放：同一个字形在 24 与 48 下分别有 2px 与 4px 的描边。这正是源 SVG 中 `stroke-width` 的含义，也是图标放大之后依然清晰可读的原因。",
            "`strokeWidth` is measured in the DATA's units, so the same picture can be told in a 24-unit space or a 48-unit one. Without `viewBox` the data is taken as 24 and drawn 1:1 -- which is why the third glyph below is cut: its cross lives between 10 and 38, but the box is 24 wide.": "`strokeWidth` 是以数据的单位衡量的，所以同一幅图既可以写在 24 单位的空间里，也可以写在 48 单位的空间里。没有 `viewBox` 时数据被当作 24 处理并按 1:1 绘制——这就是下面第三个字形被切掉的原因：它的十字位于 10 到 38 之间，而盒子只有 24 宽。",
            "`tone` picks the placeholder's fill from the same semantic set the chips use, so a skeleton on a dark card and one on a white card are two tones, not two hex values.": "`tone` 从 chip 所用的同一套语义色里挑选占位块的填充色，所以深色卡片上的骨架屏与白色卡片上的骨架屏是两种 tone，而不是两个十六进制值。",
            "`value` is 0..1 and the label is the widget's own first argument -- not a text node you have to place and keep in sync.": "`value` 是 0..1，标签是控件自身的第一个参数——不是你需要另外放置并保持同步的文本节点。",
            "cover: fill the box, then crop": "cover：填满盒子，然后裁剪",
            "smooth: a blend or the raw pixels": "smooth：混合插值还是原始像素",
            "viewBox: the data's own units": "viewBox：数据自身的单位",

            // ---- DocsI18n.as
            "A catalog is a flat `key -> string` table. `addMessages` MERGES, so an app overrides the two kit strings it disagrees with instead of forking all 55. Lookup walks the current locale's chain and then the default one: `zh-Hant-TW` falls back to `zh-Hant`, then `zh`, then the default, so a locale that ships half a translation still reads.": "一个目录就是一张扁平的 `key -> string` 表。`addMessages` 是「合并」，因此应用只需覆盖它有异议的那两条套件字符串，而不必把全部 55 条都分叉一份。查找时先走当前 locale 的链，再走默认 locale：`zh-Hant-TW` 退到 `zh-Hant`，再退到 `zh`，最后退到默认，所以只交付了一半译文的 locale 依然读得出来。",
            "A count is not a concatenation: English needs \"1 item\" and \"5 items\". `tn(key, n)` picks `#one`/`#other` from a small explicit table (NOT CLDR -- the kit supports the languages it ships), falls back to `#other`, and fills `{n}` itself. Chinese answers `#other` for every count, which is why the demo's zh-CN catalog has exactly one of the two rows.": "计数不是字符串拼接：英语需要「1 item」和「5 items」。`tn(key, n)` 从一张小的显式表里挑选 `#one`/`#other`（不是 CLDR —— 套件只支持它实际交付的语言），缺失时回退到 `#other`，并自己填充 `{n}`。中文对任何计数都回答 `#other`，这就是为什么 demo 的 zh-CN 目录里那两行中只有一行。",
            "A locale switch is a frame, and RTL is a layout input": "locale 切换是一帧的事，而 RTL 是一种布局输入",
            "A localized string is resolved BEFORE the factory is called: `text(I18n.t(\"demo.greet\"))`. Nothing in the tree knows what a message key is, and no widget grew a `msgKey` field for it. That is deliberate -- measure reads an intrinsic width and paint reads the displayed run, so a key on the node would push catalog knowledge into two more places and buy nothing the string form lacks.": "本地化字符串在调用工厂函数之前就已解析完毕：`text(I18n.t(「demo.greet」))`。树里没有任何东西知道什么是消息键，也没有哪个控件为此长出过 `msgKey` 字段。这是刻意的 —— measure 读的是固有宽度，paint 读的是实际显示的那段文本，所以把键挂在节点上，等于把目录知识再推进两个地方，却换不来字符串形式所缺少的任何东西。",
            "A missing key is never silent": "缺失的键绝不沉默",
            "Mirroring is not part of the strings at all: `I18n.isRTL()` is a LAYOUT input, read on every solve, so an Arabic window mirrors rows and start/end padding while the text it shows may still be English. That is exactly what `ar` does in this app -- the buttons below prove the mirror, not the translation.": "镜像根本不属于字符串的一部分：`I18n.isRTL()` 是一种布局输入，每次求解布局时都会读取，所以一个阿拉伯语窗口会镜像行方向与 start/end 内边距，而它显示的文字可能仍然是英文。这正是本应用里 `ar` 所做的事 —— 下面的按钮证明的是镜像，而不是翻译。",
            "One catalog per locale, merged per key": "每个 locale 一份目录，按 key 合并",
            "Plurals and grouped numbers": "复数形式与数字分组",
            "Text is a payload, not a field": "文本是负载，不是字段",
            "That choice's price is a silent miss -- an untranslated line would just stay English -- so it is paid at BUILD time: `tools/demo-i18n.cjs` extracts every display string from the sources and fails if the table does not cover it, or if a row has gone stale.": "这个选择的代价是「静默漏掉」—— 未翻译的一行只会保持英文 —— 所以这笔账在构建期支付：`tools/demo-i18n.cjs` 从源码里抽取每一个显示字符串，只要表没有覆盖它、或者某一行已经过期，就直接报错失败。",
            "The 267 section headings, the paragraphs under them and the 60 page blurbs are not message keys: they are written inline, next to the live demo they describe, and `DemoMessages.zh()` maps each ENGLISH SENTENCE to its translation. A lookup is one dictionary read, so the describe path allocates nothing, and a translator sees the sentence they are translating.": "267 个小节标题、它们下面的段落以及 60 段页面简介都不是消息键：它们就内联写在各自所描述的实时 demo 旁边，由 `DemoMessages.zh()` 把每一个英文句子映射到它的译文。一次查找就是一次字典读取，所以 describe 路径不产生任何分配，而译者看到的正是他要翻译的那句话。",
            "The kit's own messages -- every widget's default accessible name, the date picker's month and weekday rows -- are the FLOOR, installed lazily by `I18n` itself. An app that registers nothing still gets a localized library.": "套件自己的消息 —— 每个控件的默认可访问名称、日期选择器的月份与星期行 —— 是「地板」，由 `I18n` 自己惰性安装。什么消息都不注册的应用，拿到的仍然是一个已本地化的库。",
            "This app's prose is a table keyed by the sentence": "本应用的正文是一张以句子为键的表",
            "`number()` groups digits with the locale's own separators (`kit.number.group` / `kit.number.decimal`), so the amount below changes with the language without a line of code on this page.": "`number()` 用 locale 自带的分隔符（`kit.number.group` / `kit.number.decimal`）来分组数字，因此下面的金额会随语言变化，而本页不需要改动一行代码。",
            "`setLocale` does not redraw. It bumps an epoch; `UiApp` compares that epoch once per frame and turns it into ONE describe plus a layout re-solve. The describe is where the new strings are computed -- the same latch a theme swap uses, kept separate because a theme swap also re-resolves every node's style and a locale swap does not.": "`setLocale` 并不重绘。它只是把一个 epoch 递增；`UiApp` 每帧比较一次这个 epoch，并把它变成一次 describe 加一次布局重解。新的字符串正是在 describe 里算出来的 —— 这和主题切换用的是同一个闩锁，但刻意分开：主题切换还会重新解析每个节点的样式，而 locale 切换不会。",
            "`setStrict(true)` turns the same event into a thrown error, for a build that would rather not ship at all. The marker below is the point of this section: it is what an untranslated string LOOKS like, and it is why this page is the only place in this app where `missingKeys()` is not empty.": "`setStrict(true)` 把同一个事件变成抛出的错误，适合那种宁可不上线的构建。下面的标记正是本节的重点：它就是一个未翻译字符串「看起来」的样子，也是为什么本页是本应用里唯一 `missingKeys()` 非空的地方。",
            "`t()` cannot return null and cannot quietly return the key: an unresolved message renders as `[[key]]` and is recorded in `missingKeys()`. A probe asserts that list is empty after rendering every localized surface, so \"not translated yet\" shows up as a red gate instead of as an app that silently speaks English in a Chinese window.": "`t()` 不能返回 null，也不能悄悄返回键：未解析的消息会渲染成 `[[key]]`，并被记录进 `missingKeys()`。一个探针会在渲染完每一个本地化界面之后断言该列表为空，因此「尚未翻译」会表现为一道红色的门禁，而不是一个在中文窗口里默默说英文的应用。",
            "`t()` with no parameters returns the String INSTANCE stored in the catalog, so a re-describe compares text by pointer and allocates nothing. Only a message carrying `{placeholders}` builds a new string.": "不带参数的 `t()` 返回目录里存着的那个 String 实例，所以重新 describe 时按指针比较文本，不产生任何分配。只有携带 `{placeholders}` 的消息才会构建新字符串。",

            // ---- DocsLayout.as
            "A background is a Fill: one colour, or TWO OR MORE stops. An Array is a gradient, and `angle` is in degrees (0 = left to right, 90 = top to bottom). This backend paints LINEAR only -- radial/focal throws at construction instead of painting a different gradient than the one asked for.": "背景就是一个 Fill：单色，或者两个以上色标。Array 即渐变，`angle` 以度为单位（0 = 从左到右，90 = 从上到下）。本后端只绘制 LINEAR 渐变——径向/焦点渐变会在构造时抛错，而不是画出一个与所求不同的渐变。",
            "A box is the plain container: it lays its children out along one axis and can carry a background, a border and rounded corners. It owns no widget behaviour at all.": "box 是纯粹的容器：它沿一个轴摆放子节点，可以带背景、边框和圆角。它自身不含任何控件行为。",
            "A card in a row keeps its own height": "row 中的卡片保持自身高度",
            "A card is a box with a surface: background, a 1px border and rounded corners. It is a container, so it takes children -- and it lays them out as a column by default.": "card 是带表面的 box：背景、1px 边框和圆角。它是容器，因此接受子节点——并且默认把它们按列摆放。",
            "A column wraps into a second column": "column 换行成第二列",
            "A container can be the button": "容器本身就可以是按钮",
            "A floor that cannot hold twice is halved": "容不下两份的下限会被减半",
            "A heading is a child, not the title option": "标题是子节点，而不是 title 选项",
            "A length is a number of px or a percentage of the parent's content box. `flexGrow` then shares whatever is LEFT after the fixed children, so 1:2 splits a 300px box as 100:200.": "长度是 px 数值，或父级内容盒的百分比。随后 `flexGrow` 分配固定子节点之后剩下的空间，所以 1:2 会把 300px 的盒子分成 100:200。",
            "A pane leaves its MAIN-axis size null (`size: [null, 74]`): the widget writes the flex basis, and an explicit width in the pane's own style would win over it.": "pane 把主轴尺寸留为 null（`size: [null, 74]`）：flex basis 由控件写入，而 pane 自身样式里显式的宽度会盖过它。",
            "A percentage belongs to the parent": "百分比属于父级",
            "A row of two columns is a page split. Each column is an ordinary column and both grow, so the split survives a window resize without a single constant.": "由两个 column 组成的 row 就是分页。每列都是普通 column 且都增长，因此分栏在窗口缩放后依然成立，一个常量都不需要。",
            "A share, not two sizes": "一份占比，而不是两个尺寸",
            "An anchor that is gone takes the surface with it": "锚点消失，浮层也随之消失",
            "An auto-height column hugs its children": "自动高度的 column 紧贴其子节点",
            "Basic": "基础",
            "Box shadow": "盒阴影",
            "Cards nest -- and a title is just a text child, which is the shape that always lays out correctly. (The `title:` option draws its text without reserving space; avoid it.)": "卡片可以嵌套——而标题只是一个文本子节点，这种形态始终能正确布局。（`title:` 选项绘制文本却不预留空间，请避免使用。）",
            "Cross-axis alignment": "交叉轴对齐",
            "Direction": "方向",
            "Drag the grip: `onResize(ratio)` reports the new share on every move and again on release. Storing it in the model is the whole contract -- nothing is cached inside the widget, so resizing the window keeps the SHARE, not the pixel width.": "拖动分隔条：`onResize(ratio)` 在每次移动时、以及释放时再次上报新的占比。把它存进模型就是全部约定——控件内部不缓存任何东西，因此缩放窗口保持的是占比，而不是像素宽度。",
            "Gradient background": "渐变背景",
            "Leave the height null and the column is exactly its padding plus the sum of its children plus the gaps between them. The border below is drawn on that computed box, which is why it sits tight against the two lines -- nothing was measured by hand to make it fit.": "把高度留为 null，column 就正好等于其内边距，加上各子节点高度之和，再加上它们之间的间距。下方的边框就画在这个算出来的盒子上，因此它紧贴两行文字——没有任何一处是手工测量凑出来的。",
            "Main-axis alignment": "主轴对齐",
            "Nested rows make a two-column page": "嵌套 row 组成双栏页面",
            "Nested surface": "嵌套表面",
            "One child grows, the rest keep their size": "一个子节点增长，其余保持自身尺寸",
            "Order is stacking order": "顺序即堆叠顺序",
            "Percent and flex": "百分比与弹性",
            "Returning null is the teardown": "返回 null 就是拆除",
            "Shorthand": "简写",
            "Surface": "表面",
            "The `title:` option draws its text WITHOUT reserving space in the card's flow, so anything after it overlaps the heading. The shape that always lays out correctly is a text child first, then the body -- and a divider if the card needs one.": "`title:` 选项在绘制它的文本时完全不会在卡片的流中预留空间，因此排在它后面的任何内容都会与标题重叠。始终能正确布局的写法是：先把 text 子节点放在最前，再放正文 —— 如果卡片需要分隔线，再加一条分隔线。",
            "The anchor is found by KEY in the live tree every frame. If the node it named is not there -- scrolled away, filtered out, conditionally rendered -- the popover is not placed: there is no stale position to fall back to, and no second copy of the layout to keep in sync.": "锚点每一帧都在活动树中按 KEY 查找。如果它所指的节点不在了 —— 被滚出视野、被过滤掉、或按条件未渲染 —— 弹出层就不会被放置：既没有过期的位置可供回退，也不存在第二份布局副本需要保持同步。",
            "The default axis is a column; `flexDirection: \"row\"` in a style makes a row.": "默认轴是纵向；在样式里写 `flexDirection: 「row」` 就变成横向。",
            "The default cross-axis alignment of a row is stretch, so two cards side by side become equally tall even when their contents differ. Say `alignItems: flex-start` when each card should hug its own text -- the difference is visible below.": "横向布局的默认交叉轴对齐方式是 stretch，因此并排的两张卡片即使内容不同也会变成等高。若希望每张卡片紧贴自己的文本，就写 `alignItems: flex-start` —— 两者的差别在下方可以看到。",
            "The layer is not hidden, it is ABSENT: `renderOverlay` returns null and the reconciler removes the nodes, which is what releases their handlers and their place in the focus walk. A closed popover left in the tree at opacity 0 would keep both.": "该层不是被隐藏，而是彻底不存在：`renderOverlay` 返回 null，协调器把节点移除，正是这一步释放了它们的事件处理器以及它们在焦点遍历中的位置。一个已关闭却留在树里、透明度为 0 的弹出层会把这两样都保留下来。",
            "The middle box carries flexGrow 1 and no width; the two ends declare 64pt each. The growth comes out of the space the fixed children and the gaps left over, so the middle one is wider in the wider row below without any arithmetic in the page.": "中间的盒子带 flexGrow 1 且不写宽度；两端各自声明 64pt。增量来自固定子节点与间隙剩下的空间，因此下面更宽的那一行里中间盒子也更宽，而页面里不需要做任何算术。",
            "The same two nodes, stacked": "同样两个节点，改为纵向",
            "The second tree": "第二棵树",
            "This engine has no z-index and no such style field: the LAST child of the overlay is painted last and wins a hit test. Dialogs go last, popovers and menus before them.": "这个引擎没有 z-index，也没有这样的样式字段：overlay 的最后一个子节点最后绘制，并在命中测试中胜出。对话框放最后，弹出层和菜单排在它们之前。",
            "Two ends, nothing in between": "只有两端，中间留空",
            "`box()` takes `onClick` like every other node, so a card, a tile or a whole row can be the hit target -- no wrapper control and no event plumbing. It is the same dispatch a button uses: press, release inside, then the callback.": "`box()` 和所有其他节点一样接受 `onClick`，因此一张卡片、一块磁贴甚至整整一行都能成为命中目标 —— 不需要包一层控件，也不需要接事件管线。它用的是与按钮相同的派发方式：按下、在内部释放，然后触发回调。",
            "`direction: column` splits vertically. Nothing else changes: the grip becomes a horizontal bar, the panes keep null main-axis sizes, and `ratio` is still the FIRST pane's share of what is left after the grip.": "`direction: column` 会改为纵向切分。其余都不变：拉手变成一条水平条，两个窗格在主轴上仍然保持 null 尺寸，而 `ratio` 依旧是第一个窗格在扣掉拉手之后所剩空间中的占比。",
            "`ratio` stays inside 0..1 -- anything else is refused at factory time, because a share above 1 is not a share. `minSize` is applied ON TOP of it, to both panes, so a tiny authored ratio produces a usable grip instead of a pane you cannot see: a 0.02 share of a 294pt area would be 6pt, and 6pt loses to the 40pt minimum. A minimum wider than half the area cannot hold twice, so it is halved rather than handing one pane a negative size.": "`ratio` 必须落在 0..1 之内 —— 其他取值在工厂函数阶段就被拒绝，因为大于 1 的份额不成其为份额。`minSize` 是在它之上再施加的，而且对两个窗格都生效，所以作者写下的极小比例也会产生一个可用的拉手，而不是一个看不见的窗格：294pt 区域上 0.02 的份额会是 6pt，而 6pt 会输给 40pt 的下限。宽于区域一半的下限无法容纳两份，于是它被折半，而不是把负的尺寸交给某个窗格。",
            "`row(opts, children)` is that same box with the axis PINNED, so a style merged in later cannot stack it again -- use `row`/`column` when the axis is the control's own shape, and a plain `box` when it is only styling.": "`row(opts, children)` 就是同一个盒子，只是把轴固定住，因此之后合并进来的样式无法再把它排成纵向 —— 当轴是控件自身形态的一部分时用 `row`/`column`，当轴只是样式时用普通的 `box`。",
            "`size: [0.5, null]` means half of the PARENT's content width, so two of them plus a gap overflow the row -- which is why the pair below is sized with flexGrow instead: 1 and 1 split what is left AFTER the gap, whatever the window did.": "`size: [0.5, null]` 表示父级内容宽度的一半，因此两个这样的盒子加上一个间隙就会溢出整行 —— 这就是下面那一对改用 flexGrow 定尺寸的原因：1 和 1 分配的是扣掉间隙之后剩下的空间，无论窗口怎么变。",
            "alignItems is start / center / end. It is what centres a label against a taller neighbour -- the text node keeps its measured height and the row places it.": "alignItems 取值是 start / center / end。正是它让一个标签相对于更高的邻居居中 —— 文本节点保持自己测量出的高度，由整行来摆放它。",
            "boxShadow is DRAWN, not deferred: the runtime really renders a DropShadowFilter, and it lands on the node's background shape only -- a filter on the backing would shade the label and the children too. offset/blur/color/alpha are the four knobs AS3 has; `spread` and `inset` are GPUI fields this backend cannot honour, so they THROW.": "boxShadow 是真正被绘制出来的，而不是延迟处理：运行时确实渲染一个 DropShadowFilter，并且它只落在节点的背景形状上 —— 若把滤镜加在外层底衬上，标签和子节点也会被投上阴影。offset/blur/color/alpha 是 AS3 提供的四个旋钮；`spread` 和 `inset` 是本后端无法兑现的 GPUI 字段，因此它们会抛异常。",
            "column(opts, children) is exactly box() with direction \"column\", which is also the default -- so the two spellings are interchangeable, and this one reads better.": "column(opts, children) 就是方向为「column」的 box()，而「column」也正是默认值 —— 所以两种写法可以互换，只是这一种读起来更清楚。",
            "flexWrap on a fixed-height column: children that do not fit start a new column to the right. The same five nodes fit the 60pt band in three columns here, and the author wrote no width at all.": "在固定高度的纵向容器上使用 flexWrap：容纳不下的子节点会向右另起一列。这里的同五个节点在 60pt 高的区域内排成三列，而作者完全没有写宽度。",
            "justifyContent distributes the children along the column's own axis; the box has a fixed height here so there is slack to distribute.": "justifyContent 沿纵向容器自身的轴分配子节点；这里的盒子有固定高度，因此有多余空间可供分配。",
            "minSize 200 in a 300pt area would leave nothing for the second pane, so the widget halves it instead of handing one side a negative size: both panes end up at 150 and the split is equal. A floor is a promise about the SMALLER pane, never a licence to overflow.": "在 300pt 的区域里写 minSize 200，第二个窗格就一点空间都剩不下，于是控件把下限折半，而不是把负的尺寸交给某一侧：两个窗格最终都是 150，切分变成等分。下限是关于较小那个窗格的承诺，绝不是允许溢出的许可证。",
            "minSize is a floor, and the ratio obeys it": "minSize 是下限，比例要服从它",
            "renderOverlay() returns a tree reconciled on TOP of render()'s. It is how a floating surface escapes its parent's box: the page behind it is neither re-laid out nor clipped.": "renderOverlay() 返回的树会叠在 render() 的树之上做协调。这就是浮动表面跳出父级盒子的方式：它后面的页面既不会重新布局，也不会被裁剪。",
            "row(opts, children) is box() with direction \"row\". Children keep their own widths; `gap` is the space between them, and `alignItems` places them on the cross axis.": "row(opts, children) 就是方向为「row」的 box()。子节点保留各自的宽度；`gap` 是它们之间的间隙，`alignItems` 则负责把它们摆放在交叉轴上。",
            "space-between is the whole of a toolbar: a title that hugs the left and a control that hugs the right, with the slack handed to the gap. No spacer node.": "space-between 就是一整条工具栏：一个紧贴左侧的标题加一个紧贴右侧的控件，多余的空间全部交给间隙。不需要占位节点。",
            "splitPane(first, second, { ratio }) puts two ORDINARY nodes around a grip and keeps their sizes in step with one number: `ratio` is the FIRST pane's share of the space left after the grip (0.5 = half). The panes are children like any other -- a box, a list, a scrollView -- and the widget writes their flex basis with grow and shrink at 0, so a pane whose content is wider than its share cannot quietly eat the other one.": "splitPane(first, second, { ratio }) 把两个普通节点放在一个拉手两侧，并让它们的尺寸随一个数字联动：`ratio` 是第一个窗格在扣掉拉手之后所剩空间中的占比（0.5 = 一半）。窗格和其他节点一样就是普通子节点 —— 一个 box、一个 list、一个 scrollView —— 控件会把它们的 flex 基准写死，且 grow 与 shrink 都为 0，因此内容比自己的份额更宽的窗格无法悄悄吃掉另一个窗格。",

            // ---- DocsLive.as
            "A live board": "实时看板",
            "Pause, resume, reset": "暂停、继续、重置",
            "The market is driven by the app's frame clock, not by a timer of its own: `frameTick()` steps it and calls `model.notify(Dirty.VALUE)`. Pausing is therefore one boolean in the model -- and a paused board proves the loop really is idle, because the paint counter stops moving.": "行情由应用自身的帧时钟驱动，而不是由它自己的定时器驱动：`frameTick()` 推进行情并调用 `model.notify(Dirty.VALUE)`。因此「暂停」在模型里只是一个布尔值——而暂停后的看板恰好证明循环确实处于空闲：因为重绘计数不再变化。",
            "The rows are rebuilt from the model on every tick -- no widget caches a quote, nothing is patched behind the reconciler's back. The list beneath scrolls like any other: it is a scrollView.": "每来一次 tick，所有行都从模型重建——没有任何控件缓存报价，也没有任何东西绕开协调器在背后悄悄打补丁。下方的列表和其他列表一样可以滚动：它就是一个 scrollView。",
            "These are the app's own numbers, sampled once a second: the frames it actually drew, the nodes it holds, how many describe / paint passes it ran, and the per-pass average of the two phases that cost anything. A tick that changes a VALUE runs describe -> measure -> solve -> arrange -> paint; a tick": "这些是应用自己的数字，每秒采样一次：它实际绘制的帧数、它持有的节点数、它运行了多少遍 describe / paint，以及真正耗时的两个阶段各自的每遍平均值。一次改变 VALUE 的 tick 会依次执行 describe -> measure -> solve -> arrange -> paint；而一次 tick",
            "Twenty-two quotes, twenty-two sparklines and a composite index, redrawn ten times a second.": "二十二条报价、二十二条迷你走势线和一个综合指数，每秒重绘十次。",
            "What a frame costs": "一帧的代价",

            // ---- DocsMotion.as
            "A phone shell binds an Env before mount; every value is a plain getter, and a change is announced through the same Observable the data flow uses. A node that opts in with `safeArea: true` gets the insets folded into its padding. Bind a fake phone here and watch the box below grow a notch margin: that is the production path, not a mock.": "手机外壳会在挂载前绑定一个 Env；每个值都是普通 getter，变化通过数据流自身使用的同一个 Observable 宣告。用 `safeArea: true` 选择加入的节点，会把安全区插入值折算进自己的 padding。在这里绑定一台假手机，看看下面的方块如何长出刘海边距：这是生产路径，不是模拟。",
            "Click both: the right one is drawn, and it never answers.": "两个都点一下：右边那个照常绘制，却永不应答。",
            "Disabled is inherited and it stops the pick": "disabled 会被继承，并且会拦住命中选取",
            "Dragging is a divider that answers the pick": "拖拽就是一条能应答命中选取的分隔条",
            "Four names, four paths to the same width": "四个名字，四条通往同一宽度的路径",
            "Left: a 26pt tab. Right: the same tab inside a 44x44 container that carries the handler -- the container is what the pick walk finds, so the whole box answers.": "左边：一个 26pt 的标签页。右边：同一个标签页装在一个带处理器的 44x44 容器里——命中遍历（pick walk）找到的是容器，所以整个方块都能应答。",
            "No widget knows: UiNode.resolveStyle compares what it just resolved against what the node had, and hands the difference to the tween core. Every kind animates, unchanged.": "没有任何组件知道这件事：UiNode.resolveStyle 会把刚才解析出的结果与节点原有的值作比较，再把差异交给补间核心。每一种组件都能动起来，自身无需任何改动。",
            "Not a screenshot: 44 boxes, each one's height written as `2 + 14 * Ease.apply(...)`.": "这不是截图：44 个方块，每一个的高度都写成 `2 + 14 * Ease.apply(...)`。",
            "One field, one transition": "一个字段，一条过渡",
            "One rule in the pick walk (UiNode.inert, walking the ancestor chain) means a disabled container disables its whole subtree -- and the runtime's own hit test already honours `mouseEnabled` / `mouseChildren`, so `disabled` is the only knob a page needs.": "命中遍历里的一条规则（UiNode.inert，沿祖先链向上走）意味着：被禁用的容器会禁用它的整棵子树——而运行时自身的命中测试本就遵守 `mouseEnabled` / `mouseChildren`，所以页面只需要 `disabled` 这一个开关。",
            "Paint fields do not reflow": "绘制类字段不触发重排",
            "That is the easing table itself, and the reason a tween lands exactly on its target is visible in the last column -- every curve reaches 1, so every bar is the same height.": "这就是缓动表本身；补间之所以能精确落在目标值上，原因在最后一列就能看见——每条曲线都到达 1，所以每根柱子高度相同。",
            "The curve is a NAME, not a function pointer: a style is a data record built once at class load, so it cannot capture a closure. An unknown name throws -- a typo must not silently become a linear animation.": "曲线是一个名字（NAME），不是函数指针：样式是在类加载时一次性构建的数据记录，因此无法捕获闭包。未知名字会抛错——打错一个字绝不能悄悄变成线性动画。",
            "The curve, drawn": "曲线，画出来",
            "The grip below is a splitPane: its divider is an ordinary child node painted as a bar, which is what makes it hit-testable at all. A pointer series is normalized by PointerRouter (Pointer in, press / move / release out), and a viewport a finger can drag implements TouchScrollable. Both speak ROOT coordinates, so no transform maths.": "下面的抓手是一个 splitPane：它的分隔条就是一个普通子节点，只是被绘制成一根横条——正因如此，它才具备可命中测试的能力。指针序列由 PointerRouter 归一化（输入 Pointer，输出 press / move / release），而手指能拖动的视口实现 TouchScrollable。两者都直接使用 ROOT 坐标，因此不需要任何变换运算。",
            "The platform's answers arrive through Env": "平台的回答经由 Env 送达",
            "The target is a rectangle, and it can be bigger": "命中目标是一个矩形，而且它可以比图形本身更大",
            "This is the technique, not a workaround: the runtime hits what a node PAINTED, so the hit area is whatever the node drew. (An alpha-0 background is the invisible form.)": "这是正当技法，不是绕路补丁：运行时命中的是节点实际绘制（PAINTED）出来的东西，所以命中区域就是节点画出的范围。（alpha 为 0 的背景是它的隐形形态。）",
            "Write `transitionMs` and `transitionEase` and the field eases instead of snapping.": "写上 `transitionMs` 和 `transitionEase`，字段就会缓动过渡，而不是瞬间跳变。",
            "opacity, background, borderColor, textColor and cornerRadius change pixels only, so a tween on them costs a repaint and nothing else. Width, height, padding and gap change what flexbox must compute -- that is not a leak in the redraw rule, it is the author asking the layout to move, and it is why those fields are opt-in per node.": "opacity、background、borderColor、textColor 和 cornerRadius 只改变像素，所以对它们做补间只需一次重绘，别无其他代价。width、height、padding 和 gap 改变的是 flexbox 必须重新计算的内容——这不是重绘规则里的漏洞，而是作者主动要求布局移动，也正是这些字段需要按节点选择加入（opt-in）的原因。",

            // ---- DocsNav.as
            "A click reports an index, not a route": "点击上报的是下标，不是路由",
            "A header is a row child with role button and a key of its own, prefixed with the key of the accordion that owns it: demoAccM:h0, demoAccM:h1, demoAccM:h2 above.": "标题是 role 为 button 的 row 子节点，并且拥有自己的 key，其前缀是所属 accordion 的 key：上例即 demoAccM:h0、demoAccM:h1、demoAccM:h2。",
            "A tab strip is not a router, so the page below it is an ordinary conditional: the same selectedIndex decides which column is mounted. Switching tabs therefore replaces three nodes, not twenty -- the strip itself never changes.": "标签条不是路由器，所以它下面的页面只是一个普通的条件分支：同一个 selectedIndex 决定挂载哪个 column。因此切换标签替换的是三个节点，而不是二十个——标签条本身从不改变。",
            "A tap on the CURRENT tab is still reported -- that is how \"scroll this section to the top\" stays expressible.": "点击当前（CURRENT）标签依然会上报——这正是「把本节滚回顶部」这类需求仍能表达出来的方式。",
            "A three-deep stack": "三层深的栈",
            "A trail of crumbs": "一串面包屑",
            "A typed field survives a push": "输入过的字段能在 push 之后存活",
            "An index you can click": "一个可点击的下标",
            "Equal cells, one selected": "等分的单元格，只选中一个",
            "Every header has its own key": "每个标题都有自己的 key",
            "Every page is laid out every frame, visible or not -- so the text field on page one is never rebuilt by a push. Type something, press Next, press Back: the caret and the text are where you left them, and no page wrote a restore path to make that true. (The model still owns the string; the point is that nothing had to rebuild.)": "每一页每一帧都会被布局，无论是否可见——所以第一页上的文本框绝不会因一次 push 而被重建。输入点内容，按 Next，再按 Back：光标和文本都还在你离开时的位置，而且没有任何页面为此写过恢复路径。（字符串仍然归模型所有；要点在于没有任何东西需要重建。）",
            "Five cells are narrower, not scrolled": "五个单元格只是更窄，并不会滚动",
            "Headers are row children with role 'button' -- the ARIA shape, and also how the widget tells a header from a panel, so no key parsing or index arithmetic.": "标题是 role 为 button 的 row 子节点——这既是 ARIA 的形状，也是该控件区分标题与面板的方式，因此不需要解析 key，也不需要下标运算。",
            "It is drawn BETWEEN the crumbs only -- not before the first and not after the last -- so a slash, an angle bracket or a dot all read correctly with no spacing written by the author.": "它只画在面包屑之间——既不画在第一项之前，也不画在最后一项之后——所以斜杠、尖括号或点都能被正确阅读，作者无需书写任何间距。",
            "Items are plain labels and the callback reports an INDEX, so a crumb that needs a route or a key carries it in the author's own closure.": "各项只是纯文本标签，回调上报的是下标（INDEX），所以某一项若需要路由或 key，就由作者自己的闭包来承载。",
            "Its height is the bar's to own, so a `style.height` would only fight it.": "高度归这条栏自己所有，所以写 `style.height` 只会与它对抗。",
            "Keyboard: Left / Right WRAP": "键盘：Left / Right 会环绕（WRAP）",
            "Large title, collapsed by one number": "大标题，由一个数值决定折叠",
            "Neither end is an icon name: leading takes one node and trailing takes an array, so a back chevron, a busy spinner or a chip all fit without a second API. The title between them is the bar's own, which is why it can fold.": "两端都不是图标名：leading 接收一个节点，trailing 接收一个数组，所以返回箭头、忙碌转圈或 chip 都能放进去，不需要第二套 API。两端之间的标题归栏自己所有，这也是它能折叠的原因。",
            "Nothing is cached: the string the bar shows is the one this render returned, so a title that follows the selection needs no setter. The fold still works -- the title slides under the compact row rather than jumping to it.": "没有任何缓存：栏显示的字符串就是本次渲染返回的那一个，所以跟随选中项变化的标题不需要 setter。折叠依然有效——标题会滑到紧凑行之下，而不是跳到那一行。",
            "One panel at a time": "一次只展开一个面板",
            "Only the top page is VISIBLE; every page is measured and laid out regardless.": "只有栈顶页面是可见的（VISIBLE）；每一页无论可见与否都会被测量和布局。",
            "Open index is data": "展开的下标是数据",
            "Pages that stay mounted": "始终保持挂载的页面",
            "Press \"Focus it\", then Left / Right. A tab strip is a RING, not a sequence: Right on the last tab goes to the FIRST and Left on the first goes to the last, where a list would stop at the end. Home and End jump to the ends, and the ends are the first and last tab, not a dead stop before them.": "先按「Focus it」，再按 Left / Right。标签条是一个环（RING），而不是一个序列：在最后一个标签上按 Right 会走到第一个，在第一个上按 Left 会走到最后一个，而若是列表，到这头就停住了。Home 和 End 跳到两端，这两端就是第一个和最后一个标签，而不是它们之前的死止点。",
            "Several open at once": "同时展开多个",
            "Tapping the current tab still reports": "点击当前标签仍会上报",
            "That is the whole point of a stack: a page keeps its scroll offset and its typed text across a push and a pop, because its nodes were never rebuilt.": "这正是栈的全部意义：页面在一次 push 与一次 pop 前后保留自己的滚动偏移和已输入的文本，因为它的节点从未被重建。",
            "The bar divides its width by the number of items, so a fifth tab makes every cell sixteen percent narrower. Nothing scrolls and no tab is ever off screen -- which is the property a phone tab bar needs and a desktop tab strip does not.": "这条栏把宽度按项数平分，所以多出第五个标签会让每个单元格窄百分之十六。什么都不滚动，也没有任何标签会被挤出屏幕——这正是手机标签栏需要、而桌面标签条不需要的特性。",
            "The bar folds a large title into the compact row as the page scrolls: `collapse` goes 0 (open, `largeExtra` taller) to `largeExtra` (shut), and the fold is a CLIP -- the title slides under the compact row instead of jumping rows.": "随着页面滚动，这条栏会把大标题折进紧凑行：`collapse` 从 0（展开，高出 `largeExtra`）变到 `largeExtra`（收起），而折叠是一种裁剪（CLIP）——标题滑到紧凑行之下，而不是跳到另一行。",
            "The box is the author's": "外框尺寸由作者掌握",
            "The counter below only moves because the widget kept talking.": "下面的计数器之所以会动，只是因为组件一直在回报事件。",
            "The index picks the panel": "索引挑选面板",
            "The last crumb is the current one": "最后一个面包屑就是当前项",
            "The page wrappers are absolute and inset 0, so they contribute no height: the stack is exactly the box you declare. That is deliberate -- a stack whose height came from the tallest page would jump the moment a shorter page was pushed onto it.": "各页面的包装层是绝对定位且 inset 0，因此它们不贡献任何高度：栈的尺寸恰好就是你声明的那个框。这是刻意为之——如果栈的高度来自最高的那一页，那么一旦压入一个更矮的页面，高度就会立刻跳动。",
            "The prefix is not decoration. findByKey documents a key as unique across the whole tree, and two accordions on one page used to hand out h0 twice -- the lookup could only ever find the first one, so the second accordion was unreachable from any test or any a11y pass.": "前缀不是装饰。findByKey 规定 key 在全树范围内唯一，而同一页上的两个手风琴过去会各发出一次 h0——查找永远只能找到第一个，于是第二个手风琴在任何测试和任何无障碍检查中都无法触达。",
            "The same two nodes again with three pages: Push writes 0 -> 1 -> 2 and Pop writes back. Nothing is unmounted on the way, so page one is still behind page three after two pushes -- and activeIndex -1 (the default) means the last page, which is the one a freshly built stack should show.": "同样的两个节点，这次是三个页面：Push 写入 0 -> 1 -> 2，Pop 再写回去。过程中没有任何节点被卸载，所以两次压入之后页面一仍在页面三后面——而 activeIndex 为 -1（默认值）表示最后一页，也就是刚构建出来的栈应当显示的那一页。",
            "The selected tint fills the cell from the bar's top to its bottom, so a taller bar is a bigger target and not a bigger gap. Below: 56 against 72, same three items.": "选中着色从栏的顶部一直填到栏的底部，所以更高的栏意味着更大的点击目标，而不是更大的间隙。下方：56 与 72 对比，同样的三个条目。",
            "The separator is a string": "分隔符是一个字符串",
            "The strip is painted, not built": "条带是画出来的，不是搭出来的",
            "The title is re-pointed every frame": "标题每帧都被重新指向",
            "There are no per-tab child nodes: the widget measures the labels and paints the selected band itself, so a switch is one repaint and no reconcile.": "这里没有逐标签的子节点：组件自己测量标签、自己绘制选中色带，因此一次切换只是一次重绘，没有任何协调过程。",
            "This is the one place the keyboard deliberately differs between kinds, because the shapes differ -- a strip has no end, a listbox does (ARIA tabs wrap; a listbox selection clamps).": "这是键盘行为在不同种类之间刻意不同的唯一一处，因为形状本身就不同——条带没有终点，列表框有（ARIA tabs 会环绕；列表框的选中会夹在端点）。",
            "Two bars, two numbers": "两个栏，两个数字",
            "`activeIndex` picks the top (-1, the default, means the last page). `onBack` is the system BACK key; a desktop window has none, so the buttons here drive the same state the key would.": "`activeIndex` 指定顶页（-1 为默认值，表示最后一页）。`onBack` 是系统 BACK 键；桌面窗口没有这个键，所以这里的按钮驱动的正是该键本应驱动的那份状态。",
            "`items` is fixed-length on purpose: the cells share the bar equally, so a fifth tab makes the others narrower instead of scrolling. The selected state is a TINT (accent for the current tab, muted otherwise) applied to the cell, so a badge or a custom node inside the cell inherits it too.": "`items` 刻意是定长的：各单元格均分整个栏，所以第五个标签会让其余标签变窄，而不是滚动。选中状态是一层着色（当前标签用强调色，其余用低饱和色）施加在单元格上，因此单元格里的徽标或自定义节点也会继承它。",
            "barHeight is the compact row and largeExtra is what a large title adds on top of it. A compact bar ignores largeExtra entirely, so the same app can use one shape on a phone and the other on a desktop without branching in the page.": "barHeight 是紧凑行的高度，largeExtra 是大标题在它之上额外增加的高度。紧凑栏完全忽略 largeExtra，因此同一个应用可以在手机上用一种形态、在桌面上用另一种，而页面里不必分支。",
            "barHeight is the whole cell": "barHeight 就是整个单元格",
            "currentIndex decides which crumb is drawn as current (grey, not a link). Leaving it unset means \"the last item\", which is what a trail almost always means.": "currentIndex 决定哪个面包屑被画成当前项（灰色，不是链接）。不设置它表示「最后一个条目」，而这几乎总是面包屑轨迹想要的意思。",
            "leading and trailing are nodes": "leading 与 trailing 是节点",
            "mode 'multi' takes openIndices -- an ARRAY of open sections -- where single mode takes one activeIndex. The two are mutually exclusive and passing the wrong one THROWS, so a page cannot believe it is remembering a set that nothing reads.": "mode 'multi' 接收 openIndices——一个打开区段的数组——而单选模式接收一个 activeIndex。两者互斥，传错那个会抛出异常，这样页面就无法误以为自己记住了一个没人读取的集合。",
            "onNavigate gets the CRUMB'S index -- 0 for the first label, and never for the current one. The author's closure is what turns that index into a page change, which is why a breadcrumb needs no router to be useful.": "onNavigate 拿到的是这个面包屑的索引——第一个标签为 0，当前项则永远不会触发。真正把这个索引变成页面切换的，是作者自己的闭包，这也是面包屑不需要路由器也能有用的原因。",
            "onSelect fires for every tap, the selected one included: \"tap the tab you are on to scroll back to the top\" is the usual behaviour and it needs the event, not a guard.": "onSelect 在每次点击时都会触发，包括点击当前已选中的那个：「点一下你正处的标签回到顶部」是常见行为，它需要的是这个事件，而不是一道提前拦截。",
            "onToggle reports the header's index; nothing opens by itself, and -1 (or any out-of-range index) closes every panel.": "onToggle 回报表头的索引；没有任何面板会自行展开，而 -1（或任何超出范围的索引）会关闭全部面板。",
            "tabs() takes plain labels and reports the index. `selectedIndex` also accepts a Binding, which is the shortest way to keep it in a model field.": "tabs() 接收纯标签并回报索引。`selectedIndex` 也接受 Binding，这是把它保存在模型字段里的最短写法。",

            // ---- DocsOverlay.as
            "A drawer is not a modal layout: the main tree keeps its rects and its scroll position, which is what makes it usable next to a long list.": "抽屉不是模态布局：主树保留自己的矩形和滚动位置，正因如此它才能在长列表旁边派上用场。",
            "A host is a positioned container in the overlay tree: toasts drop into its bottom- right corner in the order they were described. Without a host, a toast has no corner.": "宿主是 overlay 树中的一个定位容器：toast 按描述顺序落入它右下角。没有宿主，toast 就没有角落。",
            "A list of actions": "一组动作",
            "A menu is a list of rows, so it answers the keys a listbox answers: Up/Down move, Home/End jump to the ends, Enter activates and Escape closes. The submenu takes Right to enter and Left to come back, which is the one pair the main list does not use -- and the reason a submenu is a child MENU rather than a nested array.": "menu 是一行行的列表，所以它响应与 listbox 相同的按键：Up/Down 移动，Home/End 跳到两端，Enter 激活，Escape 关闭。子菜单用 Right 进入、Left 返回，这是主列表唯一不用的一对键 —— 也正是子菜单是子级 MENU 而不是嵌套数组的原因。",
            "A popover closes on any press outside it by default. `closeOnOutside: false` makes it a panel you dismiss yourself, which is what a colour picker or a mini form wants: a stray click on the page must not throw the work away.": "popover 默认在它之外任何一次按下时关闭。`closeOnOutside: false` 把它变成一个由你自己关闭的面板，这正是取色器或迷你表单想要的：页面上一次误点不该把工作丢掉。",
            "A scrim plus a centred panel": "遮罩加居中面板",
            "A submenu is an item with a list": "子菜单是带列表的项",
            "A toast does NOT position itself: the host is the positioned container, and the toasts stack inside its bottom-right corner in describe order. Two hosts in one overlay is legal -- one per screen edge -- and each stacks its own children.": "toast 不会自己定位：宿主才是定位容器，toast 按描述顺序堆叠在其右下角内。一个 overlay 里放两个宿主是合法的 —— 每个屏幕边一个 —— 各自堆叠自己的子节点。",
            "A toast that is not inside a toastHost is laid out like any other node -- in the overlay's flow. Nothing breaks; it simply is not in a corner, which is how a component gallery ends up with a toast in the middle of the screen.": "不在 toastHost 里的 toast 会像任何其他节点一样布局 —— 处在 overlay 的流中。不会有任何东西坏掉；它只是不在角落里，这也正是组件画廊最后会把 toast 摆到屏幕中央的原因。",
            "A transient corner message": "短暂出现的角落消息",
            "An edge sheet": "边侧面板",
            "Anchored by key": "以 key 锚定",
            "By default a scrim press closes the dialog. That is what a confirmation wants and exactly what a FORM does not: one stray click outside and the typed text is gone.": "默认情况下，一次遮罩按下就会关闭 dialog。这正是确认框想要的，也恰恰是 FORM 不想要的：外面一次误点，输入的文字就没了。",
            "Centred in the window, not in the page": "在窗口中居中，而不是在页面中",
            "Closing is a model write": "关闭是一次模型写入",
            "Drawn here as a diagram, because the real sheet opens in the overlay tree: on left/right the number is a WIDTH and the sheet spans the full height; on top/bottom it is a HEIGHT and the sheet spans the full width. Same widget, same scrim, same close contract -- only the anchoring edge changes.": "这里画成示意图，因为真实的面板在 overlay 树里打开：在 left/right 上那个数字是 WIDTH，面板跨度占满整个高度；在 top/bottom 上它是 HEIGHT，面板跨度占满整个宽度。同一个控件，同一层遮罩，同一份关闭约定 —— 只有贴靠的边在变。",
            "Escape, a scrim click and the footer's Cancel all funnel into onClose -- the author writes `false` once, and the next render stops describing the dialog.": "Escape、点击遮罩和页脚的 Cancel 都汇聚到 onClose —— 作者只写一次 `false`，下一次渲染就不再描述这个 dialog。",
            "It closes itself": "它自己关闭",
            "It still never closes ITSELF -- `onClose` is the only writer, so the panel needs a button of its own (the one inside this popover is that button).": "它依然从不自己关闭 —— `onClose` 是唯一的写入者，所以面板需要自己有一个按钮（这个 popover 里的那个按钮就是它）。",
            "Items are strings or {label, value}": "项是字符串或 {label, value}",
            "Placement is a request": "摆放位置只是一个请求",
            "Same second tree, anchored to an EDGE instead of the centre. `side` picks which, and `size` is its width (or height for a bottom sheet).": "同一个第二树，只是贴靠到 EDGE 而不是中心。`side` 选择哪一边，`size` 是它的宽度（bottom sheet 则是高度）。",
            "Scroll the list below to the bottom and press the button: the panel still lands in the middle of the WINDOW. That is the whole difference between the second tree and a positioned box -- position:absolute is relative to a PARENT, and the parent here is the window.": "把下面的列表滚到底部再按按钮：面板依然落在 WINDOW 中央。这就是第二树与定位盒子的全部差别 —— position:absolute 是相对 PARENT 的，而这里的 parent 就是窗口。",
            "Sized by its content": "由内容决定尺寸",
            "The dialog is described in renderOverlay(), so it is laid out against the WINDOW: a page that scrolls cannot drag its dialog along with it.": "dialog 在 renderOverlay() 中描述，所以它是相对 WINDOW 布局的：会滚动的页面没法把它的 dialog 一起拖走。",
            "The factory accepts default, success and danger and throws on anything else, so a theme swap moves every toast with the rest of the kit. Pick a tone, then press the button: the toast that opens uses the one you picked.": "工厂函数接受 default、success 和 danger，其他值一律抛错，所以换主题时每个 toast 都随整套组件一起变。选一个 tone，然后按按钮：打开的 toast 用的就是你选的那个。",
            "The four placements are what the author asks for; the layer flips one when the panel would leave the window. A page therefore does not have to know where in the window its trigger ended up -- which is the case the diagram shows.": "四个摆放位置是作者的请求；当面板会离开窗口时，图层会把其中一个翻转过来。因此页面不必知道自己触发的控件最终落在窗口何处 —— 示意图展示的正是这种情况。",
            "The host owns the corner": "角落归宿主所有",
            "The keyboard map is the listbox's": "键盘映射就是 listbox 的",
            "The menu is the popover's sibling: same anchoring, same overlay, but a list of items and one selected index.": "菜单是 popover 的兄弟：锚定方式相同、浮层相同，但内容是一份条目列表加一个选中下标。",
            "The other axis: a bottom sheet": "另一条轴：底部抽屉",
            "The overlay has no z-index: the last child is painted last. Toasts stack in the order they are described, and the host is the last thing in the overlay.": "浮层没有 z-index：最后一个子节点最后绘制。toast 按描述顺序堆叠，而宿主是浮层里的最后一项。",
            "The page behind is untouched": "背后的页面原封不动",
            "The popover finds its anchor through a STABLE key, not a node reference: the anchor survives a reconcile, so a popover stays put when the page re-renders.": "popover 通过一个稳定的 key（而不是节点引用）找到自己的锚点：锚点在协调（reconcile）之后依然有效，所以页面重渲染时 popover 不会移位。",
            "The stack": "堆叠",
            "There is no default that suits every message: a 2.5s toast is right for \"saved\" and wrong for \"3 items failed to sync\". The slider sets what the next toast is given; the widget only counts it down and calls onClose.": "没有哪一种默认值能适合所有消息：2.5s 的 toast 对「已保存」是合适的，对「3 个条目同步失败」就不合适。滑块决定下一个 toast 拿到什么值；控件只负责倒数计时，然后调用 onClose。",
            "Toasts are self-expiring: `duration` decides when onClose fires, and the author's model removes it. The host stacks them bottom-right. `tone` is one of default | success | danger -- a NAME, not a colour (toast.as throws on anything else).": "toast 会自行到期：`duration` 决定何时触发 onClose，再由作者的数据模型把它移除。宿主把它们堆在右下角。`tone` 取 default | success | danger 之一 —— 它是一个名字，不是颜色（toast.as 遇到其他任何值都会抛错）。",
            "What size means on each side": "每条边上的 size 各自意味着什么",
            "Without a host there is no corner": "没有宿主就没有角落",
            "`closeOnScrim: false` makes Escape and the panel's own buttons the only exits -- the scrim still swallows the press, because a modal blocks the page, it is not a giant close button. `onClose` remains the single writer either way.": "`closeOnScrim: false` 让 Escape 和面板自己的按钮成为仅有的出口 —— 遮罩依然会吞掉按下事件，因为模态是挡住页面，它不是一颗巨大的关闭按钮。无论哪种配置，`onClose` 都是唯一的写入者。",
            "`items: [{ label: \"Move to\", submenu: [...] }]` -- the submenu is described as a child MENU of the item, so it reuses the same keyboard map, the same placement code and the same close-on-outside rule. `submenuIndex` says which item's list is open; the widget reports the ITEM index, not a flat index into a merged list.": "`items: [{ label: 「Move to」, submenu: [...] }]` —— 子菜单被描述为该条目的子菜单（MENU），所以它复用同一套键盘映射、同一份放置代码和同一条「点外面即关闭」的规则。`submenuIndex` 指明当前展开的是哪个条目的列表；控件上报的是条目下标，而不是合并成一个扁平列表后的下标。",
            "`open:false` is what removes it; the widget never removes its own node. A second toast with the same key replaces the first one's content.": "`open:false` 才是移除它的方式；控件从不自己移除节点。同 key 的第二个 toast 会替换掉第一个的内容。",
            "`side: \"left\" | \"right\" | \"top\" | \"bottom\"`. On a left/right sheet `size` is a WIDTH; on a top/bottom one it is a HEIGHT, and the layer spans the window on the other axis. An unknown side throws at describe time rather than landing on a default edge -- there is no such thing as a drawer with no edge.": "`side` 可取 left | right | top | bottom。左右两侧的抽屉里 `size` 是宽度；上下两侧的抽屉里 `size` 是高度，而这一层在另一条轴上铺满整个窗口。未知的 side 在描述阶段就抛错，而不是落回某个默认边 —— 不存在没有边的抽屉。",
            "`tone` is a NAME, not a colour: default | success | danger, and anything else throws.": "`tone` 是一个名字，不是颜色：default | success | danger，其他任何值都会抛错。",
            "`width` is a maximum-ish hint: the panel wraps its children and the placement flips when the bottom would leave the window.": "`width` 只是一个大致上限的提示：面板按内容包裹其子节点，当底部会跑出窗口时放置位置会翻转。",
            "closeOnOutside: false": "closeOnOutside: false",   // an API spelling: the heading IS the identifier
            "closeOnScrim: false, for a dialog with unsaved input": "closeOnScrim: false —— 适用于带未保存输入的对话框",
            "duration is the author's number": "duration 是作者给出的数值",
            "labelOf()/valueOf() are the same helpers the overlays use, so a menu, a select and a combobox accept exactly the same option shapes.": "labelOf()/valueOf() 就是浮层所用的同一批助手函数，所以菜单、select 和 combobox 接受的选项形状完全一致。",
            "tone is a name, not a colour": "tone 是名字，不是颜色",

            // ---- DocsPickers.as
            "A Binding is the other owner: `page: bindTo(model, \"pgIdx\")` makes the WIDGET write `model.pgIdx` when a number is clicked, and the model's notify re-renders.": "Binding 是另一种归属方式：`page: bindTo(model, 'pgIdx')` 让组件在某个页码被点击时去写 `model.pgIdx`，再由模型的 notify 触发重渲染。",
            "A calendar panel": "日历面板",
            "A locked picker shows the value it was given and refuses to open -- the panel never appears, because the press does not reach the trigger.": "锁定状态的取值器会显示当初给它的值，并拒绝打开——面板根本不会出现，因为按下事件到不了触发器。",
            "A locked picker still shows the chosen day; it just refuses to open. This is the shape a booking form uses once the date has been confirmed elsewhere.": "锁定状态的取值器仍然显示已选的那一天，只是拒绝打开。预订表单在日期已由别处确认之后，用的就是这个形态。",
            "A select that stays open": "保持打开的下拉选择",
            "Always six weeks": "永远是六周",
            "An empty result is a row you draw": "空结果就是你自画的一行",
            "An empty selection is the placeholder": "空选择就是占位符",
            "Disabled keeps the choice": "禁用时保留所选",
            "Disabled keeps the date": "禁用时保留日期",
            "Each number is a chip with role \"button\"; the current page is the `info` tone.": "每个数字都是一个 role 为「button」的 chip；当前页使用 `info` 色调。",
            "Forty pages and a window of three: the widget renders first, last, the current neighbourhood and an ellipsis for each gap. The number of chips does not grow with the page count, so a 400-page list and a 12-page list are the same width.": "四十页、窗口宽度为三：组件渲染首页、末页、当前页附近的一段，以及每处缺口的一个省略号。chip 的数量不随页数增长，所以 400 页的列表和 12 页的列表宽度相同。",
            "Nothing inside the widget": "组件内部不存任何状态",
            "Open is author-owned too": "打开状态同样归作者所有",
            "Options behind a trigger": "触发器背后的选项",
            "Page numbers with ellipses": "带省略号的页码",
            "Paging months is two model numbers": "翻月靠的是两个模型数字",
            "So a page change is a re-resolve, not a repaint hook.": "所以换页是一次重新解析，而不是一个重绘钩子。",
            "The chips are chips": "页码由 chip 构成",
            "The factory renders whatever options it is given and does NOT filter: onQuery hands you the text, and the match rule (case, accents, word-start) is yours to choose.": "工厂函数只渲染你交给它的选项，绝不过滤：onQuery 把文本递给你，匹配规则（大小写、重音符号、是否词首）由你自己决定。",
            "The grid is six week rows even in a five-week month, so paging to March does not make the panel (and everything under it) jump by one row.": "即使某个月只用五周就能排完，网格也仍然是六行星期行，所以翻到三月时，面板（以及它下面的一切）不会跳一行。",
            "The panel renders exactly the options it is given, so \"nothing matched\" is not a widget state to configure -- it is one option row with a label of your choosing, and one index the handler ignores.": "面板只渲染你交给它的选项，所以「没有任何匹配」并不是组件要配置的一种状态——它就是一行选项，标签由你自定，对应的索引由处理函数自行忽略。",
            "The placeholder is the empty string": "占位符就是空字符串",
            "The query is just a model string": "查询词只是一个模型字符串",
            "The summary follows option order": "摘要遵循选项顺序",
            "The trigger is a real textField": "触发器是一个真正的 textField",
            "The trigger line is built by walking the OPTIONS and keeping the selected ones, so it reads in menu order and never in the order the user clicked. The readout below is built the same way -- option order, not click order.": "触发器上那一行摘要来自遍历 OPTIONS 并保留被选中的项，所以它按菜单顺序显示，绝不按用户点击的先后。下面的读数也以同样方式生成——按选项顺序，而不是点击顺序。",
            "The trigger summary lists the picked labels in OPTION order, or the placeholder.": "触发器摘要按选项顺序列出被选中的标签；没有选中项时显示占位符。",
            "The visible window is computed by the same function that maps a click back to a page, so a rendered slot and a clicked slot cannot disagree.": "可见窗口由同一个函数算出，那个函数也负责把点击反查回页码，因此渲染出的槽位与被点击的槽位不可能对不上。",
            "The widget does not close itself behind your back: every open/close is reported through onOpenChange and drawn from the `open` you pass back in.": "组件不会背着你自行关闭：每一次打开/关闭都通过 onOpenChange 上报，并根据你回传的 `open` 绘制。",
            "The write happens BEFORE `onSelect`, so a listener on the binding and the callback see the same transition -- and clicking the page you are already on reports nothing at all: no callback, no write.": "写入发生在 `onSelect` 之前，所以绑定上的监听器和回调看到的是同一次变更——而点击你当前已经所在的页则完全不会有任何回报：没有回调，也没有写入。",
            "There is no tick state, no summary string and no open flag stored in the widget: all three are rebuilt from values + options on every render. That is why a toggle shows up on the next frame without the widget having to repaint itself.": "组件内部不保存勾选状态、摘要字符串和打开标志：这三者每次渲染都由 values + options 重新算出。这正是切换一下就能在下一帧显示出来的原因，组件无需自行重绘。",
            "Two pickers, one model field each: the left one has no value yet and shows the placeholder, the right one has `Team` and shows the option's label. The trigger does not fall back to the first option -- an empty value must look empty.": "两个选择器各对应一个模型字段：左侧的还没有值，显示占位文案；右侧的值为 `Team`，显示该选项的标签。触发器不会退回到第一个选项——空值看起来就必须是空的。",
            "Type to filter": "输入即筛选",
            "Typing goes through the same text field as everywhere else -- selection, caret and the CHANGE event all come from the runtime, not from key sniffing in the widget.": "输入走的是与其他地方相同的文本框——选区、光标和 CHANGE 事件都来自运行时，而不是组件里对按键的嗅探。",
            "`onQuery` is onChange under a second name, so anything that writes the model can drive it: a Clear button that puts the empty string back shows every option again, with no widget API involved.": "`onQuery` 就是换了个名字的 onChange，因此任何能写模型的东西都能驱动它：一个把空字符串写回去的「清除」按钮就能让所有选项重新出现，完全不涉及组件 API。",
            "`page` can be a Binding": "`page` 也可以是 Binding",
            "`value` is an ISO string (YYYY-MM-DD), and `year`/`month` say which month the panel shows -- so paging months is a model write, not widget state.": "`value` 是 ISO 字符串（YYYY-MM-DD），`year`/`month` 指明面板显示哪个月——所以翻月是一次模型写入，而不是组件状态。",
            "`value` is the SELECTED OPTION'S VALUE, not its index, and onSelect reports the row index. Both facts matter: the label lives in the option, the key in the model.": "`value` 是所选选项的值，而不是它的下标；而 onSelect 回报的是行下标。这两点都很重要：标签在选项里，键在模型里。",
            "`year` and `month` are the panel's view, not the widget's memory: the arrows report through onMonthChange and the next render draws whatever the model says. December rolling into January is the model's arithmetic, not a special case here.": "`year` 和 `month` 表示面板的视图，而不是组件的记忆：箭头通过 onMonthChange 上报，下一次渲染就按模型说的画。十二月翻到次年一月是模型自己的算术，这里没有特例。",
            "values is an Array the AUTHOR owns: the widget reports the clicked INDEX through onToggle(i) and never edits the array itself. The menu stays open after a toggle -- one that closed on every pick would be a select -- so it closes on Escape, on a second click on the trigger, or when the author hands back open: false.": "values 是归作者所有的 Array：组件通过 onToggle(i) 上报被点击的下标，从不自行改动该数组。切换之后菜单保持打开——每次选择就关闭的那是 select——所以它只在按 Escape、再次点击触发器，或作者回传 open: false 时才关闭。",
            "values: [] is a legal state, not a missing one -- the trigger shows the placeholder and the panel shows nothing ticked. A multi-select that forced a first pick would not be able to represent \"none yet\".": "values: [] 是合法状态，而不是缺失状态——触发器显示占位文案，面板里没有任何勾选。一个强制必须先选一项的多选，就无法表示「尚无选择」。",
            "windowSize bounds the chips, not the page": "windowSize 限制的是页码块的个数，而不是页数",

            // ---- DocsStart.as
            "A widget never keeps its own state: it reports through a callback, the model writes, and the next render re-describes the tree. This button's count lives in DocsModel.": "控件本身从不保存自己的状态：它通过回调上报，由模型写入，下一次渲染再重新描述整棵树。这个按钮的计数就存放在 DocsModel 里。",
            "Describe": "描述",
            "Every node takes a style refinement: shorthand keys (padding, gap, background, border, text, ...) or an explicit partial. Sizes are [width, height].": "每个节点都接受一份样式细化（style refinement）：既可写简写键（padding、gap、background、border、text 等），也可传入显式的 partial。尺寸以 [width, height] 表示。",
            "Mount": "挂载",
            "State": "状态",
            "Style": "样式",
            "UiApp owns the retained tree and the frame loop. mount() binds it to a stage; attachRoot() runs the first describe + reconcile + measure/arrange/paint.": "UiApp 持有保留树与帧循环。mount() 把它绑定到一个 stage 上；attachRoot() 会执行首次的 describe + reconcile + measure/arrange/paint。",
            "render() returns a description -- a tree of factories. It is pure: no addChild, no side effects, no reliance on evaluation order. It is called only on a dirty frame.": "render() 返回的是一份描述 —— 一棵由工厂构成的树。它是纯的：既不调用 addChild，也没有副作用，也不依赖求值顺序。它只在脏帧上被调用。",

            // ---- DocsSystem.as
            "A Binding is a field pointer": "Binding 就是一个字段指针",
            "A Control is a stop by default. The kinds that are a readout or a GROUP opt out -- badge, avatar, chip, progress, breadcrumb, pagination, accordion -- because a stop that does nothing when you press Enter is worse than no stop at all.": "Control 默认就是一个停靠点。属于读数（readout）或 GROUP 的类型则主动退出——badge、avatar、chip、progress、breadcrumb、pagination、accordion——因为一个按下 Enter 却什么也不做的停靠点，比根本没有停靠点更糟。",
            "A container hears its children": "容器能听见子节点",
            "A control's baseline is replaceable one kind at a time. Build the Style FROM the current default and change only what you mean -- a partial Style would write its own unset (null) fields over the baseline and erase the rest.": "控件的基线可以逐个类型地替换。请以当前默认值为基础构建 Style，只改你真正想改的部分——不完整的 Style 会用它自己未设置（null）的字段覆盖基线，把其余部分一并抹掉。",
            "A double click has to be switched on": "双击必须显式开启",
            "A keymap binds keys to ACTIONS, not to widgets": "keymap 把按键绑定到动作（ACTION），而不是绑定到控件",
            "A list, table, tree, tab strip or menu is ONE stop for the whole widget: the arrows move INSIDE it, which is the ARIA listbox/grid/tablist model and the only way a 200-row table is reachable without 200 Tab presses.": "list、table、tree、tab 条或 menu 整个控件只有一个停靠点：方向键在其内部移动，这正是 ARIA 的 listbox/grid/tablist 模型，也是不按 200 次 Tab 就能到达 200 行表格的唯一办法。",
            "A node with no `transitionMs` snaps. Unknown ease names THROW (linear | outQuad | outCubic | inOutCubic). Gradients, percent sizes and non-uniform radii do NOT tween -- there is nothing exact to interpolate, so the tween is dropped rather than approximated. The frame loop drives the clock (`getTimer`, wall time, so a 120Hz display does not run the same tween twice as fast).": "没有 `transitionMs` 的节点会瞬间跳变。未知的缓动名会抛异常（linear | outQuad | outCubic | inOutCubic）。渐变、百分比尺寸和非均匀圆角不做补间——没有可精确插值的目标，因此该补间被丢弃，而不是做近似处理。时钟由帧循环驱动（`getTimer`，真实时间，所以 120Hz 的显示器不会让同一补间跑快一倍）。",
            "A palette you can swap at run time": "可在运行时切换的调色板",
            "A phone keyboard is a rect, not a boolean: a form needs to know how much of the window is covered, and whether it is covering the BOTTOM or floating. Zero height on a desktop is the truthful answer, not a missing value.": "手机键盘是一个矩形，而不是一个布尔值：表单需要知道窗口被遮住了多少，以及遮住的是底部还是悬浮的键盘。桌面上的高度为零是诚实的答案，而不是缺少取值。",
            "A right click brings its own point": "右键自带坐标点",
            "A stop must be visible and not `inert()`. `disabled` INHERITS down the tree: a disabled card takes its whole subtree out of the mouse AND out of the ring, which is why it is one flag per element rather than a copy-down into every child.": "停靠点必须可见，且不能处于 `inert()` 状态。`disabled` 会沿树向下继承：一张禁用卡片会把它整棵子树既移出鼠标、也移出焦点环，所以它是每个元素一个标志位，而不是向每个子节点复制一份。",
            "An author colour does not move. A swap replaces the BASELINE, so the blue chip below stays blue in both themes; only the unspecific things (surfaces, borders, text, tracks) follow.": "作者设定的颜色不会改变。切换只替换基线，所以下面那个蓝色 chip 在两种主题下都是蓝色；只有那些未指定的东西（表面、边框、文字、轨道）会跟随。",
            "An author opts in per node with `cursor`, and an unknown name THROWS rather than falling back to the arrow: auto | arrow | button | hand | ibeam.": "作者用 `cursor` 逐个节点选择加入，未知名称会抛异常，而不会退回到箭头：auto | arrow | button | hand | ibeam。",
            "Below, the LAST two buttons carry indices 0 and 1, so the ring starts at the third row, not at the first button.": "下面的最后两个按钮带有索引 0 和 1，所以焦点环从第三行开始，而不是从第一个按钮开始。",
            "Both strips below are 200 wide inside 120-wide boxes: the upper one shows all of its width, the lower one is cut at the box's border box.": "下面两条色带宽度都是 200，却放在宽 120 的盒子里：上面那条完整显示出全部宽度，下面那条在盒子的边框盒处被裁掉。",
            "Disabled and hidden leave the ring": "禁用与隐藏的元素离开焦点环",
            "Double-click the left box: it counts. The right box has no handler, so the flag stays off and the same gesture reaches nothing.": "双击左边的盒子：它会被计数。右边的盒子没有处理器，所以该标志保持关闭，同一个手势触发不到任何东西。",
            "Element carries exactly three pointer callbacks: onClick, onRightClick(x, y) and onDoubleClick. There is no onPointerDown / onPointerMove / onPointerUp on an element -- continuous motion belongs to the pointer layer (see the gesture page), which is the only place a drag can be expressed without fighting the click.": "Element 恰好携带三个指针回调：onClick、onRightClick(x, y) 和 onDoubleClick。元素上没有 onPointerDown / onPointerMove / onPointerUp——连续运动属于指针层（见 gesture 页面），那是不与 click 冲突地表达拖拽的唯一地方。",
            "Install the map, focus the field, press ctrl-k.": "安装映射表，聚焦输入框，按下 ctrl-k。",
            "It is an OVERRIDE LAYER, not a write into the default table: the resolver reads it before the kind baseline, and Theme.setTheme does not touch it. So flipping light/dark keeps the author's custom button -- call clearControlDefault to get the shipped baseline back.": "它是一个覆盖层，而不是写进默认表：解析器在读取类型基线之前先读它，且 Theme.setTheme 不会碰它。所以切换 light/dark 会保留作者自定义的按钮——要拿回随包发布的基线，请调用 clearControlDefault。",
            "Kinds whose whole region IS the interactive thing (button, checkbox, radio, switch, slider, select, combobox, tabs, menu, accordion, pagination, breadcrumb, chip, datePicker) get `hand` from the theme. A SELECTABLE REGION -- list, table, tree, scroll view -- does not: a hand over every pixel of a 400px list claims every pixel is clickable, and a pointer that lies feels broken.": "整个区域本身就是可交互对象的类型（button、checkbox、radio、switch、slider、select、combobox、tabs、menu、accordion、pagination、breadcrumb、chip、datePicker）从主题获得 `hand` 光标。可选区域——list、table、tree、scroll view——则不会：在 400px 的列表上把每个像素都变成手形，就等于宣称每个像素都可点击，而会说谎的指针让人觉得坏了。",
            "Layer 1: the control default": "第 1 层：控件默认值",
            "Layer 3: text inherits, layout does not": "第 3 层：文字会继承，布局不会",
            "Layer 4: the author wins": "第 4 层：作者说了算",
            "Layout never cascades: the button keeps its own 9/14 padding and its own height, because inheriting padding or size is the classic flexbox trap that looks right on a shallow tree and diverges from every browser.": "布局从不级联：按钮保留自己的 9/14 内边距和自己的高度，因为继承内边距或尺寸是 flexbox 的经典陷阱——在浅层树上看着没问题，却与所有浏览器都不一致。",
            "Matching is FIRST-ENTRY-WINS in declaration order, modifiers are matched EXACTLY (a binding for `ctrl-s` does not fire while Shift is also held), and a keystroke that matches nothing falls through to the built-ins, so typing is untouched. The map is consulted BEFORE Tab as well: bind Tab and Tab is yours.": "匹配按声明顺序先到先得，修饰键要求精确匹配（`ctrl-s` 的绑定在同时按住 Shift 时不会触发），未匹配任何条目的按键会落到内建行为，因此打字不受影响。映射表也在 Tab 之前被查询：绑定 Tab，Tab 就归你。",
            "Nothing below reaches into a widget: the button writes the field and notifies, and the strip re-describes from the same number. That is the whole interaction contract of the kit -- a widget reports, the author writes, the next render re-describes -- and a Binding is just the shortest way to hold up your end.": "下面没有任何东西伸手进控件内部：按钮写入字段并发出通知，标签条再根据同一个数字重新描述。这就是这套组件库完整的交互契约——控件报告，作者写入，下一次渲染重新描述——而 Binding 只是你履行自己那一端的最短方式。",
            "On this desktop every inset is zero, so the two boxes below look identical on purpose. `probes/widgets/env` pulls the same tree through 47 / 0 / 34 / 0 and asserts the arithmetic (and a rotation back to zero).": "在这个桌面上所有内边距都是零，所以下面两个盒子故意看起来一模一样。`probes/widgets/env` 把同一棵树依次按 47 / 0 / 34 / 0 跑一遍，并断言这组算术（以及再旋转回零）。",
            "Only meaningful once the row WRAPS. `alignContent` places the LINE BOXES in the cross-axis space the lines did not use: `space-between` pushes the first line to the top, the last to the bottom and spreads the rest.": "只有在这一行发生换行（WRAP）之后才有意义。`alignContent` 把各个行盒（LINE BOX）放到这些行未用掉的交叉轴空间里：`space-between` 把第一行推到顶部、最后一行推到底部，其余的均匀铺开。",
            "Only some kinds are stops": "只有部分类型是停靠点",
            "Only the typography subset cascades (fontFamily, fontSize, fontWeight, fontStyle, colour, leading, letterSpacing, textAlign, whiteSpace, textOverflow, textDecoration) plus `visibility`. So the box below sets 16px bold indigo once and BOTH children pick it up -- including the button, whose own 14px baseline is lower priority than the inherited value.": "只有排版这一子集会级联（fontFamily、fontSize、fontWeight、fontStyle、colour、leading、letterSpacing、textAlign、whiteSpace、textOverflow、textDecoration），再加上 `visibility`。所以下面这个盒子只需设置一次 16px 粗体靛蓝，两个子节点都会继承到——包括那个按钮，它自己 14px 的基线优先级低于继承来的值。",
            "Pointer events BUBBLE, so a handler on a container is also a handler for every node inside it. Right-click the small square: the OUTER box counts it, because the inner one has no handler and the press keeps going up the tree.": "指针事件会冒泡（BUBBLE），所以容器上的处理器同时也是其内部每个节点的处理器。右键点击那个小方块：计数的是外层（OUTER）盒子，因为内层没有处理器，按下事件继续沿树上冒。",
            "Press Toggle: the left tile eases 120->220 and blue->red in 320ms; the right one has the same two styles and no transition, so it jumps.": "按下 Toggle：左块在 320ms 内以缓动从 120->220、并从蓝变红；右侧那块拥有同样的两组样式却没有过渡，所以它会瞬间跳变。",
            "Removing a node from LAYOUT is the author's decision in this kit, not a style's: `render()` returns what exists this pass, and a node that should take no space is a node you do not build. (The style field `display: \"none\"` exists and the native engine implements it -- the AS3 engine does not; see the last section.)": "在这套组件库里，把节点从布局（LAYOUT）中移除是作者的决定，而不是样式的决定：`render()` 返回的是本次渲染实际存在的东西，而一个不该占空间的节点就是你不去构建的节点。（样式字段 `display: 「none」` 确实存在，原生引擎也实现了它——AS3 引擎没有；见最后一节。）",
            "Switching it on globally would change what a fast second click means for every control in the app, so `UiNode` sets it on exactly the nodes that carry an `onDoubleClick` handler -- the flag follows the handler, not the author.": "全局打开它会改变整个应用里每个控件对「快速第二次点击」的含义，所以 `UiNode` 只在那些真正带有 `onDoubleClick` 处理器的节点上打开它——这个标志跟着处理器走，而不是跟着作者走。",
            "THE ONE TRAP: writing ANY flex field (grow, shrink or basis) REPLACES the item's base size, so `flexShrink: 0` alone means `flex: 0 0 0` and the node collapses to nothing -- measured here, 120 -> 0. Write the basis you start from.": "唯一的陷阱：写入任何一个 flex 字段（grow、shrink 或 basis）都会替换该项目的基准尺寸，所以单写 `flexShrink: 0` 等于 `flex: 0 0 0`，节点会塌缩成零——此处实测为 120 -> 0。请写出你起始的基准尺寸。",
            "Tab moves the ring; Shift+Tab walks it back": "Tab 移动焦点环；Shift+Tab 反向回走",
            "That pair is exactly what `menu({ atX, atY })` wants, so opening a menu at the click is one assignment. The press BUBBLES like any other event, so a handler on a container also hears its children.": "这一对坐标正好就是 `menu({ atX, atY })` 想要的，所以在点击处打开菜单只需一次赋值。按下事件和任何其他事件一样会冒泡，所以容器上的处理器也能听到它的子节点。",
            "The Element flag `visible: false` is CSS `visibility: hidden`: nothing paints, but the node still measures, still arranges, and still holds its slot -- so a page does not jump when it comes back. The style spelling of the same thing is `visibility: \"hidden\"`, and it INHERITS to the subtree (a hidden card hides its buttons), which is what `display: none` would otherwise be reached for.": "Element 上的标志 `visible: false` 相当于 CSS 的 `visibility: hidden`：什么也不绘制，但节点仍然参与测量、仍然参与排版、仍然占住自己的位置——所以页面在它回来时不会跳动。同一件事的样式写法是 `visibility: 「hidden」`，而且它会继承到整棵子树（隐藏的卡片会隐藏它的按钮），而这原本是人们会改用 `display: none` 去达到的效果。",
            "The bits themselves are the vocabulary a view uses to say what changed -- all four behave alike at the boundary today.": "这些位本身就是视图用来表达「变了什么」的词汇——今天这四种在帧边界上的表现完全一致。",
            "The button below really tries to focus the inner control and reports the refusal: `focusNode` returns without focusing an inert or invisible node instead of half-focusing it.": "下面这个按钮真的会尝试聚焦内部的控件，并报告这次拒绝：`focusNode` 遇到惰性或不可见的节点会直接返回，而不是把它只聚焦一半。",
            "The buttons below swap the DOCS APP itself, not a card inside it. That is the feature: a theme is application-wide, and a preview that themed one panel only would be a lie about what the call does. Press Light to come back.": "下面的按钮切换的是文档应用（DOCS APP）本身，而不是它内部的某张卡片。这正是这个特性：主题是全应用范围的，如果预览只给一个面板上主题，那就在谎报这个调用的作用。按 Light 可以回来。",
            "The call still takes effect on the NEXT resolve, and a mounted node only re-resolves when something stales it. To see it now, bump the epoch yourself: Theme.setTheme(Theme.tokens().clone()) -- the same path a theme swap takes, one call, no re-mount.": "这个调用仍然会在下一次解析（resolve）时生效，而一个已挂载的节点只有在某件事让它失效时才会重新解析。想现在就看到效果，就自己抬高 epoch：Theme.setTheme(Theme.tokens().clone())——这和切换主题走的是同一条路径，一次调用，无需重新挂载。",
            "The cursor is a policy, not a default": "光标是一项策略，而不是默认值",
            "The docs app does exactly this once: `DocsMain` subscribes and turns every notify into `app.invalidate(dirty)`. The counter below is a SECOND listener, so subscribing and unsubscribing changes the count without changing the page.": "文档应用正是这样做了恰好一次：`DocsMain` 订阅，并把每次通知都转成 `app.invalidate(dirty)`。下面的计数器是第二个（SECOND）监听器，所以订阅和取消订阅会改变计数，却不会改变页面。",
            "The field is the only owner": "字段是唯一的持有者",
            "The four nodes below sit in one row on purpose: press Tab and the ring only ever lights the last one, because a chip is a tag and a progress bar is a readout.": "下面四个节点故意排在同一行：按 Tab 时焦点环只会亮在最后一个上，因为 chip 是一个标签，而进度条只是一处读数。",
            "The interface answers `reduceMotion` and the kit replays it faithfully -- but no widget reads it yet: a transition still runs at full duration when the system asks for less motion. That is a stated gap rather than a silent fallback, and it is on the list before any mobile shell ships. The value itself is live below.": "接口会回答 `reduceMotion`，组件库也忠实地转述它——但目前没有任何控件读取它：当系统要求减少动效时，过渡仍按完整时长播放。这是一处已明确声明的缺口，而不是静默的降级，它已经在任何移动端外壳发布前要处理的清单上。这个值本身在下面实时显示。",
            "The layout engine has always taken it; the NODE now consumes it too -- as a clip window on the box, so a child that does not fit stops at the edge instead of painting over its neighbours. That was library work, not a compiler fix: the gap registered as compiler-gaps G29 turned out to be a field nobody read, because `scrollRect` and `mask` already clip identically on both runtimes.": "布局引擎一直都接受它；现在节点（NODE）也会消费它——作为盒子上的裁剪窗口，让放不下的子节点在边缘处停下，而不是画到邻居身上。那是库的工作，不是编译器修复：登记为 compiler-gaps G29 的缺口，结果只是一个没人读取的字段，因为 `scrollRect` 和 `mask` 在两个运行时上的裁剪本来就完全一致。",
            "The map below is kept in `WidgetKeys`'s own header, because \"which control answers to which arrow\" is the one part of this contract nobody can guess: WRAP vs CLAMP is semantics, not taste -- a tab strip or a tree is a ring, a list or a grid is a sequence whose ends are walls (ARIA listbox/grid).": "下面这张映射表保存在 `WidgetKeys` 自己的文件头里，因为「哪个控件响应哪个方向键」是这份契约里没人能猜到的部分：WRAP 与 CLAMP 属于语义，而不是品味——tab 条或树是一个环，列表或网格则是一个序列、两端是墙（ARIA listbox/grid）。",
            "The mask is recorded (`invalidate(dirty)` ORs it) and the frame boundary asks one question: is anything pending? If yes, the view is described and reconciled ONCE.": "掩码会被记录下来（`invalidate(dirty)` 把它按位或进去），而帧边界只问一个问题：还有待处理的东西吗？如果有，视图就被描述并协调（reconcile）一次。",
            "The native arm (NativeLayoutEngine, Yoga) implements all three. So `display` and `aspectRatio` are real fields -- they typecheck, they merge, they reach UiNode -- and on the pure-AS3 arm they are a ONE-WAY DOOR INTO AN ERROR, which is why this page cannot show them live: a page that throws takes the whole tour with it, and the correct thing to show is the refusal itself.": "原生那条分支（NativeLayoutEngine、Yoga）三者都实现了。所以 `display` 和 `aspectRatio` 是真实字段——它们能通过类型检查、能合并、能到达 UiNode——而在纯 AS3 那条分支上，它们是一扇只能通向错误的单向门，这就是本页无法现场展示它们的原因：一个抛异常的页面会把整个导览一起带走，而正确该展示的正是这次拒绝本身。",
            "The node's own refinement is merged LAST, so it beats the control default and the inherited value. Two buttons, one style key apart -- and this is why variants are styles and not kinds: there is exactly one button behaviour.": "节点自身的细化（refinement）最后合并，所以它压过控件默认值和继承来的值。两个按钮，只差一个样式键——这也正是为什么变体是样式而不是类型：按钮的行为只有一种。",
            "The platform answers through ONE interface": "平台通过一个（ONE）接口回答",
            "The point is not brevity: a bound control has NO local copy of the value, so the field and the pixels cannot disagree.": "重点不在简洁：绑定过的控件没有值的本地副本，所以字段和像素不可能互相矛盾。",
            "The runtime only emits `doubleClick` when the HIT TARGET's own `doubleClickEnabled` is true, and it defaults to FALSE (measured on adl 51.4.1).": "只有当命中目标（HIT TARGET）自己的 `doubleClickEnabled` 为 true 时，运行时才会发出 `doubleClick`，而它默认是 FALSE（在 adl 51.4.1 上实测）。",
            "The values below are read live from the running app, so this page cannot drift from the code: a chip that disagrees with its own sentence is visible.": "下面的取值都是从运行中的应用实时读取的，所以本页不可能与代码脱节：一个与自己那句话不一致的 chip 是看得见的。",
            "The window is the BORDER box, not the padding box: the node's own background and border ride in the same sprite, so a padding-box window would shave them. Two consequences: hit testing follows the clip (a spilling child stops being interactive, which is what `overflow: hidden` means everywhere else), and the node's own box shadow is clipped too -- put a shadow on a WRAPPER when both are wanted. `overflow: \"scroll\"` clips like `hidden`; the scrolling itself is `scrollView`'s job, and it keeps its own viewport crop.": "这个窗口是边框盒（BORDER box），而不是内边距盒：节点自己的背景和边框就画在同一个 sprite 里，所以用内边距盒当窗口会把它们削掉。两个后果：命中测试跟随裁剪（溢出的子节点不再可交互，这正是其他所有地方 `overflow: hidden` 的含义），节点自己的盒子阴影也会被裁掉——两者都想要时，请把阴影放到外层包装（WRAPPER）上。`overflow: 「scroll」` 的裁剪和 `hidden` 一样；滚动本身是 `scrollView` 的职责，它会保留自己的视口裁剪。",
            "Theme.tokens() is read-only by contract. To customise one slot: clone it, assign, then setTheme -- copying in is what keeps the epoch honest.": "`Theme.tokens()` 按约定是只读的。要定制某一个槽位：先 `clone()` 它，赋值，然后 `setTheme` —— 正是「把它复制进来」这一步让 epoch 保持诚实。",
            "Theme.tokens() is the live palette: 47 slots, ONE instance, read by every widget at paint time. Theme.setTheme(ThemeTokens.dark()) copies a palette in, rebuilds the per-kind baselines and the overlay chrome, and bumps themeEpoch(). UiApp compares that epoch at the frame boundary, marks every node style-stale and asks for one re-describe -- so the whole tree follows in ONE frame, with no relayout (a palette never changes a number).": "`Theme.tokens()` 就是那份实时调色板：47 个槽位，只有一个实例，每次绘制时都被每个控件读取。`Theme.setTheme(ThemeTokens.dark())` 把一份调色板复制进来，重建按 kind 划分的基线以及 overlay 的装饰层，并递增 `themeEpoch()`。`UiApp` 在帧边界比较这个 epoch，把每个节点标记为样式过期，并要求重新 describe 一次 —— 于是整棵树在同一帧内跟上，而且没有重排（调色板从不改变任何数值）。",
            "This page documents the WHOLE style vocabulary, so it has to say which parts of it the shipped layout engine actually implements. `seam/asaot/ui/as3/` throws on three calls by design (seam/README.md's table): a wrong rectangle would be worse than a refused one, and the refusal names the gap.": "本页记录的是整个 style 词汇表，所以它必须说明其中哪些部分真正由随附的布局引擎实现。`seam/asaot/ui/as3/` 会在三个调用上按设计抛错（seam/README.md 中的表格）：一个错误的矩形比一个被拒绝的矩形更糟，而拒绝本身会指明缺口所在。",
            "Three 120-wide children in a 300-wide row is 360 of demand, so 60 has to go.": "300 宽的 row 里放三个 120 宽的子节点，需求是 360，所以必须有 60 让出去。",
            "Three engine calls the AS3 layout engine refuses": "AS3 布局引擎会拒绝的三个引擎调用",
            "Three handlers, and that is the list": "三个处理函数，整张清单就这些",
            "Three pieces, one job each. `KeyStroke` parses \"ctrl-shift-s\" into a key code plus four modifier flags; `ContextExpr` parses \"editor > modal\" into a predicate over the tags on the FOCUS CHAIN; `ActionRegistry` holds the actions and the map from a keystroke to an action id.": "三块东西，各管一件事。`KeyStroke` 把「ctrl-shift-s」解析成一个键码加四个修饰键标志；`ContextExpr` 把「editor > modal」解析成作用于 FOCUS CHAIN 上各标签的谓词；`ActionRegistry` 存放动作，以及从按键到动作 id 的映射。",
            "Transitions: transitionMs + transitionEase": "过渡：transitionMs + transitionEase",
            "UiApp turns Enter or Space into the focused node's click, so a keyboard user never needs a per-kind key handler for the simple case. The one exception is deliberate: when the focus target is an editable TextField, Enter is that field's COMMIT and Space is a character -- swallowing either would break typing.": "UiApp 把 Enter 或 Space 变成焦点节点的 click，所以键盘用户在最简单的情形下永远不需要为某种 kind 写按键处理函数。唯一的例外是刻意的：当焦点目标是可编辑的 TextField 时，Enter 是该字段的 COMMIT，Space 则是一个字符 —— 吞掉任何一个都会破坏输入。",
            "Wake the field with Focus it and press Tab: the ring goes field -> Second -> back to the field.": "用 Focus it 唤醒该字段，再按 Tab：焦点环走 field -> Second -> 回到 field。",
            "What really saves work is the PER-NODE bit: a repaint never re-solves layout, which is why a hover and a spinner cost no measure/arrange at all. The counters below are the app's own fields, read on every render.": "真正省下工作的是那个 PER-NODE 位：一次重绘从不重新求解布局，这就是为什么 hover 和 spinner 完全不产生 measure/arrange。下面的计数器是应用自己的字段，每次渲染时读取。",
            "What to write instead: `visible: false` (previous section) hides without reclaiming space; a node that should take NO space is a node `render()` does not return this pass; and an aspect ratio is `size: [w, w / 2]`.": "该改成什么写法：`visible: false`（上一节）隐藏但不回收空间；应当完全不占空间的节点，就是 `render()` 本次不返回的节点；而宽高比写成 `size: [w, w / 2]`。",
            "Which keys each kind answers": "每种 kind 响应哪些键",
            "With no style at all, a control is painted by the kit's baseline FOR ITS KIND -- a button gets 9/14 padding, a 1px #D0D0D0 border, a 6px radius and #FFF1F3F5; a text input gets 7/10 and a white fill; a checkbox gets neither. Nothing here is a constant of the layout engine: it is a table (`Theme.controlDefault`).": "完全不写 style 时，一个控件由套件为它这种 kind 提供的基线来绘制 —— button 得到 9/14 的 padding、1px 的 #D0D0D0 边框、6px 圆角和 #FFF1F3F5；text input 得到 7/10 和白色填充；checkbox 两者都没有。这里没有任何东西是布局引擎的常量：它是一张表（`Theme.controlDefault`）。",
            "`Control.action` is an action ID. With one set, Enter or Space runs the ACTION and does NOT also run `onClick` -- one press, one effect. A control without an action keeps the plain click, so nothing changes for code that never names one.": "`Control.action` 是一个动作 ID。设置之后，Enter 或 Space 执行该 ACTION，并且不会同时执行 `onClick` —— 一次按键，一个效果。没有设置动作的控件保留普通 click，所以从不指定动作的代码行为不变。",
            "`Observable.subscribe(listener)` returns a `Subscription`; `unsubscribe(s)` detaches it. Listeners run synchronously in registration order and are never called after they are removed -- which is what makes a controller free to subscribe in its constructor and unsubscribe in its teardown.": "`Observable.subscribe(listener)` 返回一个 `Subscription`；`unsubscribe(s)` 把它解绑。监听器按注册顺序同步执行，并且在被移除之后绝不会再被调用 —— 正因为如此，控制器才可以放心地在构造函数里订阅、在销毁时取消订阅。",
            "`UiApp.env` is always an `Env`: nine read-only answers about the window the app lives in -- safe area, keyboard rect, pixel ratio, touch/hover, reduce motion, app state, dark mode, locale -- plus a subscription for the ones that change. An app that says nothing gets `DesktopEnv` (zeros and a mouse), and a phone shell binds its own before `mount`; `bindEnv(null)` THROWS, because an app that cannot say what platform it is on has a bug, not a default.": "`UiApp.env` 始终是一个 `Env`：关于应用所处窗口的九个只读答案 —— 安全区、键盘矩形、像素比、touch/hover、减弱动效、应用状态、深色模式、locale —— 外加一个针对会变化项的订阅。什么都不声明的应用拿到 `DesktopEnv`（全零加一个鼠标），手机外壳则在 `mount` 之前绑定自己的实现；`bindEnv(null)` 会抛错，因为一个说不清自己在什么平台上的应用是 bug，不是默认值。",
            "`UiApp` walks the RETAINED tree in reading order and moves the library's focus pointer, then CANCELS the runtime's own Tab walk -- otherwise one press would move two rings. A stop is a node with `tabEnabled` that is visible and not inside a disabled subtree.": "`UiApp` 按阅读顺序遍历 RETAINED 树并移动库自己的焦点指针，然后取消运行时自带的 Tab 遍历 —— 否则一次按键会移动两个焦点环。一个焦点停靠点是一个带 `tabEnabled` 的节点，它可见，且不在被禁用的子树之内。",
            "`WidgetKeys` is an OPTIONAL interface -- one `is` test at the one call site, so the 26 kinds that do not care pay nothing. It is called only for the FOCUSED node, after Tab, and a return of true means \"consumed\" (the caller then cancels the runtime's default action for that key).": "`WidgetKeys` 是一个可选（OPTIONAL）接口 —— 唯一调用点上只做一次 `is` 测试，所以那 26 种不关心它的 kind 什么都不用付。它只对被 FOCUSED 的节点调用，且在 Tab 之后；返回 true 表示「consumed」（调用方随后取消运行时对该键的默认行为）。",
            "`action` takes over Enter; `tabIndex` orders the ring": "`action` 接管 Enter；`tabIndex` 排定焦点环顺序",
            "`alignItems` is the row's default for the cross axis; `alignSelf` lets ONE child opt out of it. Both take flex-start / flex-end / center / stretch / baseline, and an unknown value THROWS rather than quietly centring.": "`alignItems` 是 row 在交叉轴上的默认值；`alignSelf` 让某一个子节点从中退出。两者都接受 flex-start / flex-end / center / stretch / baseline，未知值会抛错，而不是悄悄地按居中处理。",
            "`bindTo(model, \"field\")` reads one public field and writes it back, notifying Dirty.VALUE on every write. Eleven factories accept one where a value is an index, a flag or a string: checkbox.checked, toggle.checked, radio.selected, slider.value, textField.value, textArea.value, list.selectedIndex, table.selectedIndex, tabs.selectedIndex, pagination.page, and accordion.activeIndex/openIndices.": "`bindTo(model, 「field」)` 读取一个公有字段并写回，每次写入都通知 Dirty.VALUE。有十一个工厂函数可以在取值是索引、标志或字符串的地方接受它：checkbox.checked、toggle.checked、radio.selected、slider.value、textField.value、textArea.value、list.selectedIndex、table.selectedIndex、tabs.selectedIndex、pagination.page，以及 accordion.activeIndex/openIndices。",
            "`borderBox` (the kit's default, and CSS's own default once you opt in) means `size` INCLUDES padding and border. `contentBox` means `size` is the CONTENT, so the padding and the border grow the box outward -- the same 120-wide request becomes a 144-wide node. Pick one per component and never mix them in a row.": "`borderBox`（套件的默认值，也是你在 CSS 里主动选用时的默认值）表示 `size` 包含 padding 和 border。`contentBox` 表示 `size` 是内容，于是 padding 和 border 会把这个盒子向外撑大 —— 同样 120 宽的请求会变成一个 144 宽的节点。每个组件选一种，且绝不要在同一行里混用。",
            "`flexShrink` (default 1) shares that deficit by SIZE: the two shrinkers give 30 each. A child with `flexShrink: 0` is a floor -- it keeps its 120 and the others pay the whole deficit. This is also the switch that makes `overflow` visible: a shrinkable child never sticks out.": "`flexShrink`（默认 1）按 SIZE 分摊这份亏空：两个可收缩的子节点各让出 30。带 `flexShrink: 0` 的子节点是一个下限 —— 它保住自己的 120，亏空全由其他节点承担。这也正是让 `overflow` 得以显形的开关：可收缩的子节点永远不会越出边界。",
            "`onRightClick(x, y)` hands you the STAGE coordinates of the press, because a right click exists to say \"open something HERE\" -- a handler without the point would have to guess it from the pointer, which no event field exposes.": "`onRightClick(x, y)` 交给你这次按下的 STAGE 坐标，因为右键存在的意义就是「在这里打开某个东西」—— 没有这个坐标的处理函数只能从指针去猜，而没有任何事件字段会暴露指针位置。",
            "`opacity` multiplies what the node PAINTS (it is the backing object's alpha), and it INHERITS: a 0.4 parent makes its children 0.4 too, which is what makes a dimmed modal a single number instead of a colour per child. Hover and press modulation composes on top of it, so a disabled area at 0.4 is still visibly disabled.": "`opacity` 乘到节点实际绘制的内容上（它就是背后绘制对象的 alpha），而且会继承：0.4 的父节点会让它的子节点也变成 0.4，这正是为什么一个变暗的 modal 只用一个数字就够，而不必为每个子节点各调一次颜色。hover 与 press 的调制叠加在它之上，所以 0.4 的禁用区域看起来仍然是禁用的。",
            "`overflow` is where a box stops painting: `visible` (default), `hidden`, `scroll`.": "`overflow` 决定一个盒子在哪里停止绘制：`visible`（默认）、`hidden`、`scroll`。",
            "`padding` pushes the CONTENT in from the node's own edge. `margin` moves the node itself away from its siblings and from its parent's content edge -- the row below has `gap: 0`, so every pixel between the tiles is the middle tile's margin.": "`padding` 把内容从节点自己的边缘向内推。`margin` 则把节点本身从它的兄弟节点、以及父节点的内容边缘推远 —— 下面那一行的 `gap: 0`，所以几块小方片之间的每一像素都是中间那块方片的 margin。",
            "`safeArea: true` adds the platform inset to a container's OWN padding, on the edges it names (`[\"top\"]` is just the status bar). It goes into PADDING, so the box still fills the window: the background runs under the notch and only the content moves in. It adds to the padding you wrote, and it is not inherited -- a child that does not ask keeps exactly its own numbers.": "`safeArea: true` 把平台内边距加到容器自己的 padding 上，只加在它指明的那些边上（`[「top」]` 就只是状态栏）。它是加进 PADDING 的，所以盒子依然铺满窗口：背景延伸到刘海下面，只有内容向里移。它与你写的 padding 相加，而且不会被继承 —— 没有主动声明的子节点，保留的就是它自己那几个数字。",
            "`setKeymap` takes an ARRAY of { context, bindings } objects -- there is no JSON class in this compiler, so a JSON string would need its own parser -- and it validates every string ONCE, at install time: a typo in a modifier fails when you install the map, not at 3am on the one key the user pressed.": "`setKeymap` 接收一个由 { context, bindings } 对象组成的数组 —— 这个编译器里没有 JSON 类，所以一个 JSON 字符串得自带解析器 —— 并且它会在安装时一次性校验每个字符串：修饰键里的拼写错误会在你安装这份映射时就失败，而不是等到凌晨三点、用户按下那唯一一个键的时候。",
            "`size` is the box you ask for; `minSize` and `maxSize` clamp what you get. The clamp wins over the request in both directions, and it is applied by the layout engine AFTER the flex solve -- which is why a scroll view stops its own content from shrinking with a min and never with a flex.": "`size` 是你请求的盒子；`minSize` 和 `maxSize` 决定你实际得到什么。这个夹取在两个方向上都压过请求值，而且由布局引擎在 flex 求解之后才施加——这就是为什么滚动视图是用 min、而绝不用 flex 来阻止自身内容收缩。",
            "`tabIndex` orders the ring the way HTML does: every node with an explicit index comes first, ascending (ties in document order), and everything left at -1 follows in document order. -1 means \"no explicit index\", NOT \"unreachable\" -- that is what `tabEnabled` and `disabled` are for.": "`tabIndex` 按 HTML 的方式给焦点环排序：所有带显式索引的节点排在前面，按升序排列（相同则按文档顺序），其余仍为 -1 的节点再按文档顺序跟在后面。-1 表示「没有显式索引」，而不是「不可达」——后者是 `tabEnabled` 和 `disabled` 的职责。",
            "`transitionMs` + `transitionEase` retarget the ANIMATABLE fields after every resolve, so the tween intercepts the single place every widget paints from and no widget file knows about it: opacity, background, borderColor, text colour, a uniform corner radius, width/height, padding and gap.": "`transitionMs` + `transitionEase` 在每次 resolve 之后把可动画字段重定向，因此补间拦截了所有控件共同取用的那唯一一处，而没有任何控件文件需要知道它的存在：opacity、background、borderColor、文字颜色、统一圆角半径、宽/高、padding 和 gap。",
            "alignContent: where the wrapped lines go": "alignContent：换行后的各行放在哪里",
            "alignSelf: one child disagrees with the row": "alignSelf：某个子项与整行不一致",
            "boxSizing: where the border and the padding live": "boxSizing：边框和内边距算在哪里",
            "flexShrink: who gives way": "flexShrink：谁来让步",
            "keyboardRect is the other inset": "keyboardRect 是另一块内缩区",
            "margin is outside, padding is inside": "margin 在外，padding 在内",
            "notify: what a bit actually costs": "notify：一个标志位实际要付多少代价",
            "opacity": "opacity",   // an API spelling: the heading IS the identifier
            "overflow: where painting stops": "overflow：绘制停在哪条边界",
            "reduceMotion is carried, not obeyed yet": "reduceMotion 只是被传递，尚未被遵循",
            "safeArea is padding, on the box that ASKS for it": "safeArea 是内边距，加在主动请求它的那个盒子上",
            "setControlDefault: an override layer, and it survives a swap": "setControlDefault：一层覆盖层，而且能扛过主题切换",
            "size, minSize, maxSize": "size、minSize、maxSize",
            "subscribe returns a Subscription": "subscribe 返回一个 Subscription",
            "visible: false keeps the box, and the space": "visible: false 保留盒子，也保留它占的空间",

            // ---- DocsText.as
            "A badge is a number or short string in a pill. It has no layout of its own either: you place it in a row, or absolutely on a corner.": "徽标（badge）是胶囊形里的一段数字或短字符串。它同样没有自己的布局：你要么把它放进一行里，要么把它绝对定位到某个角上。",
            "A card is a padded column, so a divider inside it spans the card's CONTENT box rather than its border box. The hairline therefore stops short of the rounded corners with no inset written by the author.": "卡片（card）是一个带内边距的列，所以卡片里的分割线跨越的是卡片的内容盒（CONTENT box）而不是边框盒。因此这条细线会在圆角之前收住，作者不需要写任何 inset。",
            "A chip is a small tonal tag. `tone` picks one of the kit's three semantic fills: neutral, info or danger -- there is no per-chip colour to keep in sync.": "标签片（chip）是一个带色调的小标记。`tone` 从组件库的三种语义填充色中选一种：neutral、info 或 danger —— 不存在需要逐个 chip 同步的颜色。",
            "A chip takes onClick like any control, so a filter bar is a row of chips and one model field. The selected chip is the one whose tone the render chose.": "chip 像任何控件一样接受 onClick，所以一个筛选栏就是一行 chip 加一个模型字段。被选中的那个 chip，就是渲染时给它选了对应 tone 的那个。",
            "A count pill": "计数胶囊",
            "A divider inside a card": "卡片内的分割线",
            "A fixed 36pt circle beside two auto-height lines. The row's height comes from the text, and `alignItems: center` puts the circle in the middle of it -- the same arrangement a list row uses, with no magic number anywhere.": "一个固定的 36pt 圆圈，旁边是两行自动高度的文本。行高来自文本，`alignItems: center` 把圆圈放在这行高度的正中 —— 与列表行的排法完全相同，任何地方都没有魔数。",
            "A hairline that measures itself: 1px tall in a column (width stretches), 1px wide in a row (height stretches). Nothing to size.": "一条自己给自己定尺寸的细线：在列中高 1px（宽度拉伸），在行中宽 1px（高度拉伸）。无需指定尺寸。",
            "A log line: a neutral time, an info status, a danger failure. The three tones are the kit's semantic fills, so a theme change moves all of them at once and this page never names a hex value for any of them.": "一条日志行：中性色的时间、info 状态、danger 失败。这三种 tone 都是组件库的语义填充色，所以换主题时它们会一起变化，而本页自始至终没有为其中任何一个写出十六进制颜色值。",
            "A long value next to a short label": "短标签旁的长值",
            "A new name is a paint, not a reflow": "新名字只触发重绘，不触发重排",
            "A run of text": "一段文本",
            "Alignment, italic, tracking, leading": "对齐、斜体、字距、行距",
            "An alias for text()": "text() 的别名",
            "Any corner, not just the top right": "任意角，不只是右上角",
            "Chips wrap: the row is a `row` with flexWrap, and the chip's own intrinsic width means nothing has to be measured by hand.": "chip 会换行：这一行是带 flexWrap 的 `row`，而 chip 自身的固有宽度意味着无需手工测量任何东西。",
            "Clickable": "可点击",
            "Disabled is a container property": "disabled 是容器属性",
            "Disabled is inherited": "disabled 会被继承",
            "Ellipsis": "省略号",
            "Every size the toolkit ships is a plain number: 11 for metadata, 12 for prose, 13/14 for body, 20/22 for titles. Nothing is scaled by a theme at run time.": "工具包提供的每个字号都是一个普通数字：元信息用 11，一般行文用 12，正文用 13/14，标题用 20/22。运行时没有任何尺寸会被主题缩放。",
            "Horizontal": "水平",
            "In a list": "在列表中",
            "Inheritance": "继承",
            "Initials from a name": "由姓名得出首字母",
            "It does not go through TextFormat.underline: that property's gap (compiler-gaps.md G28) was closed in v0.4.303, so the runtime paints its own underline now, but this style must also cover strikethrough and overline -- AIR's TextFormat has no property for either -- and drawing all three from one set of line metrics is what keeps them on the same row. strikethrough and overline are therefore ADDITIONS: AIR has no equivalent. An unknown value THROWS rather than silently drawing nothing.": "它并不走 TextFormat.underline：该属性的缺口（compiler-gaps.md G28）已在 v0.4.303 补齐，所以运行时现在自己绘制下划线；但这个样式还必须覆盖删除线和上划线 —— AIR 的 TextFormat 对这两者都没有属性 —— 而用同一套行度量来绘制这三种线，正是让它们落在同一行的原因。因此 strikethrough 和 overline 属于 ADDITIONS（增强）：AIR 没有对应物。遇到未知值时它会 THROW（抛错），而不是静默地什么都不画。",
            "Labels line up when they share a width": "标签共享同一宽度时就会对齐",
            "Nothing counts for you: the badge draws whatever string it is given, and clamping to 99+ is the author's expression at the call site. That is the whole API -- a pill, a tone, and the text.": "没有任何替你计数的逻辑：badge 画你给它的任何字符串，而把数值钳制到 99+ 是作者在调用处写的表达式。整个 API 就这些 —— 一个胶囊、一个 tone 和一段文本。",
            "On a corner": "放在角上",
            "Pinned to a corner with position:absolute -- the container is `relative`, the badge is offset from its top-right, and neither node moves the other.": "用 position:absolute 钉在某个角上 —— 容器是 `relative`，badge 相对它的右上角偏移，两个节点都不会挪动对方。",
            "Text style INHERITS: a child that sets no colour picks up its ancestor's. That is why a tile needs no per-child style -- set it on the box and every label follows.": "文本样式是 INHERITS（继承）的：没有设置颜色的子节点会沿用祖先的颜色。这就是一个平铺块不需要为每个子节点单独设样式的原因 —— 在盒子上设一次，所有标签都跟着走。",
            "The avatar takes a NAME, not a character: it derives the initial itself, so it can be fed straight from data without a helper at the call site.": "头像接收的是一个名字（NAME），而不是一个字符：首字母由它自己推导，所以可以直接拿数据喂它，调用处不需要任何辅助函数。",
            "The first letter of each of the first TWO whitespace-separated words, uppercased: grace -> G, Ada B. Lovelace -> AB (the third word is dropped). A blank name yields no letters at all -- the circle stays empty, which is what an unknown user should look like rather than a placeholder initial.": "取前 TWO（两个）以空白分隔的单词各自的首字母，并转为大写：grace -> G，Ada B. Lovelace -> AB（第三个词被丢掉）。空名字不产生任何字母 —— 圆圈保持空白，这才是未知用户应该呈现的样子，而不是一个占位的首字母。",
            "The initials rule, spelled out": "首字母规则，逐条讲清",
            "The label fixes 80pt; the value is allowed 200pt and truncates with an ellipsis (nowrap plus textOverflow). Hover is not needed to prove it: the value is longer than the box in the source, so what you see is the end of the line.": "标签固定为 80pt；值允许 200pt，并以省略号截断（nowrap 加上 textOverflow）。不需要靠悬停来证明这一点：在源码里这个值本身就已经比盒子长，所以你看到的就是这行的结尾。",
            "The label is a string, not a count": "标签是字符串，不是计数",
            "The person row where it actually lives": "人物行在实际界面里的样子",
            "The right-hand chip sits in a container that says `disabled`, so it is drawn at the disabled alpha and the pick walk never reaches it. No per-chip flag, no second code path -- click both and only the left one counts.": "右侧的 chip 位于一个声明了 `disabled` 的容器里，因此它以 disabled 的 alpha 绘制，拾取遍历也永远走不到它。没有逐个 chip 的标志位，也没有第二条代码路径 —— 两个都点一下，只有左边那个会计数。",
            "The row separator in a list": "列表中的行分隔线",
            "The three tinted 300px boxes below share one size and differ only in alignment.": "下面三个带底色的 300px 盒子尺寸相同，只有对齐方式不同。",
            "The two rows differ by one word: the second row's container says `disabled`, and the label dims along with the field. A label needs no flag of its own -- `inert` walks the ancestor chain and the paint pass multiplies the alpha.": "两行只差一个词：第二行的容器声明了 `disabled`，于是标签跟着输入框一起变暗。标签不需要自己的标志位 —— `inert` 会沿祖先链向上走，绘制阶段再乘上 alpha。",
            "Three rows and two hairlines. Each divider is 1pt tall and stretches to the list's width because its cross axis is unset -- the list declares the width once, and no divider is measured by hand.": "三行加两条细线。每条分割线高 1pt，并拉伸到列表的宽度，因为它的交叉轴没有设置 —— 列表只声明一次宽度，没有任何分割线是被手工量出来的。",
            "Tones": "色调",
            "Tones carry meaning, not colour": "色调承载语义，而非颜色",
            "Two rows whose labels are wildly different lengths. The fields start at the same x because both labels declare 80pt -- the toolkit has no align-labels pass, only the one number the author writes in both places.": "两行的标签长度相差很大。两个输入框却从同一个 x 开始，因为两个标签都声明了 80pt —— 工具包没有专门对齐标签的 pass，只有作者在两处写下的那一个数字。",
            "Type scale": "字号阶梯",
            "Underline, strikethrough, overline": "下划线、删除线、上划线",
            "Vertical": "竖向",
            "Wrapping": "换行",
            "`inset` is top/right/bottom/left with null meaning unset. Two badges on one box, pinned to opposite corners: neither takes space in the box's layout, so the box keeps exactly the size the author gave it.": "`inset` 是上/右/下/左，null 表示未设置。一个盒子上挂两个 badge，钉在相对的角上：两者都不占盒子布局的空间，所以盒子完全保持作者给出的尺寸。",
            "`leading` is the line box (line height), not the gap: 12px text with `leading: 24` occupies 24 per line. `letterSpacing` adds per character, and `fontStyle: \"italic\"` selects the face's italic cut rather than skewing the roman one.": "`leading` 是行框（行高），不是间隙：12px 文本配 `leading: 24`，每行就占 24。`letterSpacing` 按字符累加，而 `fontStyle: 「italic」` 选的是字体自带的斜体字面，而不是把正体倾斜。",
            "`payload` recomputes the initials when the name changes and returns false: the diameter comes from the style, so neither the name nor the tone can move anything. Press the button and watch the layout solve counter, not the avatar.": "名字变化时 `payload` 会重新计算首字母并返回 false：直径来自样式，所以名字和 tone 都动不了任何东西。按一下按钮，盯的是布局求解计数器，而不是头像。",
            "`textAlign` aligns the line inside the node's own width. A text node that does not wrap sizes its field to the run itself, so an alignment there used to be a silent no-op; the kit now places the run inside the node's content box, and `whiteSpace: \"normal\"` is no longer part of the recipe -- it decides whether the run may WRAP, nothing else.": "`textAlign` 在节点自身的宽度内对齐这一行。一个不换行的文本节点会把它的 field 收缩到正好包住这段文本本身，所以在那里设对齐以前是一个静默的空操作；现在组件库会把这段文本放进节点的内容盒里，而 `whiteSpace: 「normal」` 也不再是配方的一部分 —— 它只决定这段文本能否换行（WRAP），别的什么都不管。",
            "label(content, opts) is text() -- it registers no kind of its own, so it costs nothing at run time. It exists to say \"this is a form row's name\" at the call site.": "label(content, opts) 就是 text() —— 它不注册自己的 kind，所以运行时零成本。它的存在只是为了在调用处说明「这是表单某一行的名称」。",
            "orientation:\"vertical\" in a row. This is the usual way to separate two toolbars without a border on either of them.": "在 row 里写 orientation:「vertical」。这是把两个工具栏分隔开的常用做法，两边都不用加边框。",
            "text() is the only node that owns a string. It measures itself through a real TextField, so it needs no size: the engine gets the measured width as a point size.": "text() 是唯一自己持有一个字符串的节点。它通过真实的 TextField 测量自己，所以不需要尺寸：引擎拿到的是测得的宽度，作为点尺寸（point size）。",
            "textDecoration draws a rule under, through or over EVERY line, from the line metrics the layout pass already produced -- so the rule and the glyphs cannot disagree about where a line is, and a wrapped run carries a rule per line rather than one long line across the wrap.": "textDecoration 会在每一（EVERY）行的下方、中间或上方画一条线，依据是布局 pass 已经产出的行度量 —— 所以线和字形不会对「一行位于哪里」各执一词，而一段换行的文本是每行各带一条线，而不是一条长线横跨整段换行。",
            "textOverflow: \"ellipsis\" truncates one line to the FINAL box width, so it can only happen at paint time. A wrapped node ignores it -- truncating a wrapped run would collapse the lines the measure pass just laid out.": "textOverflow: 「ellipsis」把一行截断到最终（FINAL）的盒子宽度，所以它只能在绘制（paint）时发生。会换行的节点忽略它 —— 截断一段已换行的文本，会把 measure pass 刚排好的行全部压掉。",
            "whiteSpace: \"normal\" wraps at the node's POINT width and publishes the WRAPPED height, which is what an auto-height node needs. The height depends on the width, so a percent width is refused (throws) rather than guessed at measure time.": "whiteSpace: 「normal」按节点的点（POINT）宽度换行，并公布换行（WRAPPED）后的高度，这正是自动高度节点所需要的。高度取决于宽度，所以百分比宽度会被拒绝（抛出异常），而不是在 measure 时瞎猜一个。"
            };
        }

